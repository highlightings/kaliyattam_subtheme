<?php

/**
 * @file
 * Functions to support theming in the Kaliyattam Arts Theme.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;

/**
 * Implements hook_preprocess_html().
 */
function kaliyattam_subtheme_preprocess_html(array &$variables): void {
  // Add node-type class to body if viewing a node.
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface) {
    $variables['attributes']['class'][] = 'page-node-' . $node->id();
    $variables['attributes']['class'][] = 'node--type-' . Html::cleanCssIdentifier($node->bundle());
  }
}

/**
 * Implements hook_preprocess_page().
 */
function kaliyattam_subtheme_preprocess_page(array &$variables): void {
  // Attach navigation library to all pages for responsive menu functionality.
  $variables['#attached']['library'][] = 'kaliyattam_subtheme/navigation';

  // Support /node/{node}/timeline for Location and Event nodes by embedding appropriate view.
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() === 'view.timeline_theyyam.page_timeline') {
    $node = $route_match->getParameter('node');
    if (is_string($node) || is_numeric($node)) {
      $node = \Drupal\node\Entity\Node::load($node);
    }
    if ($node instanceof \Drupal\node\NodeInterface) {
      $view_content = NULL;
      if ($node->bundle() === 'location') {
        $view_content = views_embed_view('timeline_location', 'page_timeline', $node->id());
      }
      elseif ($node->bundle() === 'event') {
        if ($node->hasField('field_where') && !$node->get('field_where')->isEmpty()) {
          $view_content = views_embed_view('timeline_location', 'page_timeline', $node->get('field_where')->target_id);
        }
        elseif ($node->hasField('field_theyyam') && !$node->get('field_theyyam')->isEmpty()) {
          $view_content = views_embed_view('timeline_theyyam', 'page_timeline', $node->get('field_theyyam')->target_id);
        }
      }
      if ($view_content) {
        if (isset($variables['page']['content']['kaliyattam_subtheme_content'])) {
          $variables['page']['content']['kaliyattam_subtheme_content'] = $view_content;
        }
        elseif (isset($variables['page']['content']['system_main'])) {
          $variables['page']['content']['system_main'] = $view_content;
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_node().
 */
function kaliyattam_subtheme_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  $variables['attributes']['class'][] = 'node--type-' . Html::cleanCssIdentifier($node->bundle());
  $variables['attributes']['class'][] = 'node--view-mode-' . Html::cleanCssIdentifier($variables['view_mode']);

  // Remove contextual links from card and teaser view modes to prevent clashing with card links.
  if (in_array($variables['view_mode'], ['card', 'teaser', 'minicard', 'miniteaser'], TRUE)) {
    unset($variables['title_suffix']['contextual_links']);
    if (!empty($variables['attributes']['class']) && is_array($variables['attributes']['class'])) {
      $variables['attributes']['class'] = array_values(array_diff($variables['attributes']['class'], ['contextual-region']));
    }
  }

  // Accurately determine if node is pinned (sticky flag or personal user sticky).
  $is_pinned = FALSE;
  if ($node->isSticky()) {
    $is_pinned = TRUE;
  }
  elseif (\Drupal::hasService('flag')) {
    try {
      /** @var \Drupal\flag\FlagServiceInterface $flag_service */
      $flag_service = \Drupal::service('flag');
      $sticky_flag = $flag_service->getFlagById('sticky_timeline');
      if ($sticky_flag && $sticky_flag->isFlagged($node)) {
        $is_pinned = TRUE;
      }
      else {
        $user_sticky_flag = $flag_service->getFlagById('sticky_user_timeline');
        if ($user_sticky_flag && $user_sticky_flag->isFlagged($node, $node->getOwner())) {
          $is_pinned = TRUE;
        }
      }
    }
    catch (\Exception $e) {
      // Fallback
    }
  }
  $variables['is_pinned'] = $is_pinned;
  if ($is_pinned && !empty($variables['attributes']['class'])) {
    $variables['attributes']['class'][] = 'timeline-card--sticky';
  }

  // Provide author metadata, user timeline link, and user follow flag for node templates.
  $author = $node->getOwner();
  $author_name = $author ? $author->getDisplayName() : 'Kaliyattam Artist';
  $author_uid = $author ? $author->id() : 1;
  $variables['author_name'] = $author_name;
  $variables['author_uid'] = $author_uid;
  $variables['author_initial'] = mb_strtoupper(mb_substr($author_name, 0, 1));
  $variables['author_url'] = '/user/' . $author_uid . '/timeline?page=1';
  if ($author && \Drupal::hasService('flag.link_builder')) {
    try {
      $variables['flag_follow_user'] = \Drupal::service('flag.link_builder')->build('user', $author_uid, 'favorite_user');
    }
    catch (\Exception $e) {
      $variables['flag_follow_user'] = [];
    }
  }

  // Build mini-calendar widget for Event full view mode.
  if ($node->bundle() === 'event') {
    $date_field = $node->hasField('field_when') && !$node->get('field_when')->isEmpty()
      ? $node->get('field_when')
      : ($node->hasField('field_event__date') && !$node->get('field_event__date')->isEmpty() ? $node->get('field_event__date') : NULL);

    if ($date_field) {
      $start_ts = (int) $date_field->value;
      $end_ts = (int) ($date_field->end_value ?? $start_ts);

      $year = (int) date('Y', $start_ts);
      $month = (int) date('n', $start_ts);
      $month_name = date('F', $start_ts);
      $month_padded = sprintf('%02d', $month);

      $first_day_ts = mktime(0, 0, 0, $month, 1, $year);
      $total_days = (int) date('t', $first_day_ts);
      $start_weekday = (int) date('w', $first_day_ts); // 0 (Sun) to 6 (Sat)

      $days_data = [];
      for ($d = 1; $d <= $total_days; $d++) {
        $day_start = mktime(0, 0, 0, $month, $d, $year);
        $day_end = mktime(23, 59, 59, $month, $d, $year);
        $is_event_date = ($start_ts <= $day_end && $end_ts >= $day_start);
        $day_padded = sprintf('%02d', $d);

        $days_data[] = [
          'day' => $d,
          'day_padded' => $day_padded,
          'is_event' => $is_event_date,
          'url' => "/events/{$year}/{$month_padded}/{$day_padded}",
          'label' => date('F j, Y', $day_start),
        ];
      }

      $variables['event_calendar'] = [
        'year' => $year,
        'month' => $month,
        'month_padded' => $month_padded,
        'month_name' => $month_name,
        'month_year_label' => $month_name . ' ' . $year,
        'year_url' => "/events/{$year}",
        'month_url' => "/events/{$year}/{$month_padded}",
        'weekdays' => ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'],
        'leading_empty' => $start_weekday,
        'days' => $days_data,
        'total_days' => $total_days,
      ];
    }
  }

  // Prepare translated related Theyyam items for Location full view mode.
  if ($node->bundle() === 'location' && $node->hasField('field_theyyam') && !$node->get('field_theyyam')->isEmpty()) {
    $entity_repository = \Drupal::service('entity.repository');
    $current_langcode = \Drupal::languageManager()->getCurrentLanguage(\Drupal\Core\Language\LanguageInterface::TYPE_CONTENT)->getId();
    $related = [];
    foreach ($node->get('field_theyyam')->referencedEntities() as $theyyam_entity) {
      if (!$theyyam_entity instanceof \Drupal\node\NodeInterface) {
        continue;
      }
      /** @var \Drupal\node\NodeInterface $theyyam_trans */
      $theyyam_trans = $entity_repository->getTranslationFromContext($theyyam_entity, $current_langcode);
      $media_id = NULL;
      if ($theyyam_trans->hasField('field_featured_image') && !$theyyam_trans->get('field_featured_image')->isEmpty()) {
        $media_id = $theyyam_trans->get('field_featured_image')->target_id;
      }
      elseif ($theyyam_entity->hasField('field_featured_image') && !$theyyam_entity->get('field_featured_image')->isEmpty()) {
        $media_id = $theyyam_entity->get('field_featured_image')->target_id;
      }

      $body_text = '';
      if ($theyyam_trans->hasField('body') && !$theyyam_trans->get('body')->isEmpty()) {
        $body_text = strip_tags($theyyam_trans->get('body')->value);
      }
      elseif ($theyyam_entity->hasField('body') && !$theyyam_entity->get('body')->isEmpty()) {
        $body_text = strip_tags($theyyam_entity->get('body')->value);
      }

      $related[] = [
        'id' => $theyyam_trans->id(),
        'label' => $theyyam_trans->label(),
        'url' => $theyyam_trans->toUrl('canonical')->toString(),
        'media_id' => $media_id,
        'snippet' => $body_text ? (mb_substr(trim($body_text), 0, 140) . '…') : '',
      ];
    }
    $variables['related_theyyams'] = $related;
  }

  // Generate flag links and interaction elements for full node views (posts, temples, theyyam, events).
  if (in_array($node->bundle(), ['post', 'location', 'theyyam', 'event'], TRUE)) {
    $variables['#attached']['library'][] = 'kaliyattam_subtheme/timeline-feeds';

    // Comment count calculation for interaction bar badge.
    $comment_count = 0;
    if ($node->hasField('field_comments_without_title') && !$node->get('field_comments_without_title')->isEmpty()) {
      $comment_count = (int) $node->get('field_comments_without_title')->comment_count;
    }
    elseif ($node->hasField('field_comments') && !$node->get('field_comments')->isEmpty()) {
      $comment_count = (int) $node->get('field_comments')->comment_count;
    }
    $variables['comment_count'] = $comment_count;

    if (\Drupal::hasService('flag.link_builder')) {
      $link_builder = \Drupal::service('flag.link_builder');
      foreach (['favorite_node', 'like_node', 'bookmark'] as $flag_id) {
        try {
          $variables['flag_' . $flag_id] = $link_builder->build('node', $node->id(), $flag_id);
        }
        catch (\Exception $e) {}
      }
    }
  }

  // Build interactive location map and directions for Location full view.
  if ($node->bundle() === 'location' && $node->hasField('field_geofield') && !$node->get('field_geofield')->isEmpty()) {
    try {
      $variables['location_map'] = $node->get('field_geofield')->view([
        'type' => 'leaflet_formatter_default',
        'label' => 'hidden',
        'settings' => [
          'leaflet_map' => 'OSM Mapnik',
          'height' => 420,
          'height_unit' => 'px',
          'zoom' => 15,
          'minZoom' => 1,
          'maxZoom' => 20,
          'scrollWheelZoom' => FALSE,
          'reset_map' => ['control' => TRUE],
        ],
      ]);
      $geo_item = $node->get('field_geofield')->first();
      if ($geo_item) {
        $variables['location_lat'] = $geo_item->lat;
        $variables['location_lon'] = $geo_item->lon;
        $variables['location_directions_url'] = 'https://www.google.com/maps/dir/?api=1&destination=' . $geo_item->lat . ',' . $geo_item->lon;
      }
    }
    catch (\Exception $e) {}
  }

  // Set wiki metadata for Theyyam and Location nodes.
  if (in_array($node->bundle(), ['theyyam', 'location'], TRUE)) {
    $variables['is_wiki_page'] = TRUE;
    $variables['last_updated_date'] = \Drupal::service('date.formatter')->format($node->getChangedTime(), 'medium');
  }
}

/**
 * Implements hook_preprocess_media().
 */
function kaliyattam_subtheme_preprocess_media(array &$variables): void {
  // Suppress contextual links and contextual-region on media displayed in cards, teasers, and grids.
  $card_media_modes = ['16_9_medium', '4_3_medium', 'hero', 'card', 'teaser', 'thumbnail', '3_4_225x300_focal_point_webp'];
  if (empty($variables['view_mode']) || in_array($variables['view_mode'], $card_media_modes, TRUE)) {
    unset($variables['title_suffix']['contextual_links']);
    if (!empty($variables['attributes']['class'])) {
      if (is_array($variables['attributes']['class'])) {
        $variables['attributes']['class'] = array_values(array_diff($variables['attributes']['class'], ['contextual-region']));
      }
      elseif (is_string($variables['attributes']['class'])) {
        $variables['attributes']['class'] = trim(str_replace('contextual-region', '', $variables['attributes']['class']));
      }
    }
  }
}

/**
 * Implements hook_entity_view_alter().
 */
function kaliyattam_subtheme_entity_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display): void {
  if ($entity->getEntityTypeId() === 'media') {
    $card_media_modes = ['16_9_medium', '4_3_medium', 'hero', 'card', 'teaser', 'thumbnail', '3_4_225x300_focal_point_webp'];
    if (in_array($display->getMode(), $card_media_modes, TRUE)) {
      unset($build['#contextual_links']);
    }
  }
  elseif ($entity->getEntityTypeId() === 'node') {
    if (in_array($display->getMode(), ['card', 'teaser', 'minicard', 'miniteaser'], TRUE)) {
      unset($build['#contextual_links']);
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function kaliyattam_subtheme_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'node_post_form' || $form_id === 'node_post_edit_form') {
    kaliyattam_subtheme_alter_post_form($form, $form_state);
  }
  elseif (in_array($form_id, ['node_event_form', 'node_event_edit_form'])) {
    kaliyattam_subtheme_alter_content_node_form($form, $form_state, 'event');
  }
  elseif (in_array($form_id, ['node_theyyam_form', 'node_theyyam_edit_form'])) {
    kaliyattam_subtheme_alter_content_node_form($form, $form_state, 'theyyam');
  }
  elseif (in_array($form_id, ['node_location_form', 'node_location_edit_form'])) {
    kaliyattam_subtheme_alter_content_node_form($form, $form_state, 'location');
  }
}

/**
 * Helper to transform the node post form into a social feed composer.
 */
function kaliyattam_subtheme_alter_post_form(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  // Attach the dedicated post-composer library.
  $form['#attached']['library'][] = 'kaliyattam_subtheme/post-composer';
  $form['#attributes']['class'][] = 'post-composer-form';

  // Customize submit button into prominent "Post" button.
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Post');
    $form['actions']['submit']['#attributes']['class'][] = 'button--post';
  }

  // Get current user display info.
  $current_user = \Drupal::currentUser();
  $display_name = $current_user->getDisplayName() ?: 'Kaliyattam Artist';
  $initial = mb_strtoupper(mb_substr($display_name, 0, 1));

  // Author header.
  $form['post_composer_header'] = [
    '#type' => 'inline_template',
    '#template' => '
      <div class="post-composer-header">
        <div class="post-composer-avatar" aria-hidden="true">{{ initial }}</div>
        <div class="post-composer-meta">
          <span class="post-composer-author">{{ name }}</span>
          <span class="post-composer-badge">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1a7 7 0 0 0 0 14A7 7 0 0 0 8 1zm0 2.5a4.5 4.5 0 0 1 4.5 4.5c0 1.2-.5 2.3-1.3 3.1-.3-.6-.8-1.1-1.5-1.4a2 2 0 0 0-.7-.2V9a1 1 0 0 0-1-1H7V7a1 1 0 0 0-1-1h-.5a1 1 0 0 0-1 1v.5H4a4.5 4.5 0 0 1 4-4z"/></svg>
            ' . t('Public') . '
          </span>
        </div>
      </div>
    ',
    '#context' => [
      'initial' => $initial,
      'name' => $display_name,
    ],
    '#weight' => -10,
  ];

  // Action Bar below field_content.
  $form['post_composer_actions'] = [
    '#type' => 'inline_template',
    '#template' => '
      <div class="post-composer-actions-bar">
        <span class="post-composer-actions-label">' . t('Add to your post') . '</span>
        <div class="post-composer-action-buttons">
          <button type="button" class="post-action-btn post-action-photo" data-action="photo" title="' . t('Attach Photo / Media') . '">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <span>' . t('Photo') . '</span>
          </button>
          <button type="button" class="post-action-btn post-action-video" data-action="video" title="' . t('Attach Video') . '">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            <span>' . t('Video') . '</span>
          </button>
          <button type="button" class="post-action-btn post-action-emoji" data-action="emoji" title="' . t('Insert Emoji') . '">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
            <span>' . t('Emoji') . '</span>
          </button>
          <button type="button" class="post-action-btn post-action-tag" data-action="tag" title="' . t('Tag Topics') . '">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span>' . t('Topic') . '</span>
          </button>
          <button type="button" class="post-action-btn post-action-advanced" data-action="advanced" title="' . t('Advanced Options') . '">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>' . t('Advanced') . '</span>
          </button>
        </div>
        <div class="post-composer-emoji-tray" hidden>
          <div class="emoji-tray-header">
            <span>' . t('Choose an emoji') . '</span>
            <button type="button" class="emoji-tray-close" aria-label="' . t('Close') . '">&times;</button>
          </div>
          <div class="emoji-tray-grid">
            <button type="button" class="emoji-btn" data-emoji="😊">😊</button>
            <button type="button" class="emoji-btn" data-emoji="🙏">🙏</button>
            <button type="button" class="emoji-btn" data-emoji="🎭">🎭</button>
            <button type="button" class="emoji-btn" data-emoji="🛕">🛕</button>
            <button type="button" class="emoji-btn" data-emoji="✨">✨</button>
            <button type="button" class="emoji-btn" data-emoji="🌟">🌟</button>
            <button type="button" class="emoji-btn" data-emoji="❤️">❤️</button>
            <button type="button" class="emoji-btn" data-emoji="🔥">🔥</button>
            <button type="button" class="emoji-btn" data-emoji="👏">👏</button>
            <button type="button" class="emoji-btn" data-emoji="🎉">🎉</button>
            <button type="button" class="emoji-btn" data-emoji="🌺">🌺</button>
            <button type="button" class="emoji-btn" data-emoji="🎨">🎨</button>
            <button type="button" class="emoji-btn" data-emoji="📍">📍</button>
            <button type="button" class="emoji-btn" data-emoji="💬">💬</button>
            <button type="button" class="emoji-btn" data-emoji="👍">👍</button>
            <button type="button" class="emoji-btn" data-emoji="🙌">🙌</button>
          </div>
        </div>
      </div>
    ',
    '#weight' => 2.5,
  ];

  // Group references and visibility into "Tag this post" collapsible details.
  $form['tag_this_post'] = [
    '#type' => 'details',
    '#title' => t('Tag this post'),
    '#open' => FALSE,
    '#weight' => 2.8,
    '#attributes' => [
      'class' => ['post-composer-tag-details'],
      'id' => 'post-composer-tag-drawer',
    ],
  ];

  if (isset($form['field_theyyam'])) {
    $form['tag_this_post']['field_theyyam'] = $form['field_theyyam'];
    unset($form['field_theyyam']);
  }
  if (isset($form['field_where'])) {
    $form['tag_this_post']['field_where'] = $form['field_where'];
    unset($form['field_where']);
  }
  if (isset($form['field_visibility'])) {
    $form['tag_this_post']['field_visibility'] = $form['field_visibility'];
    unset($form['field_visibility']);
  }

  // Group auxiliary fields into an Advanced container.
  $form['advanced_settings'] = [
    '#type' => 'container',
    '#tree' => FALSE,
    '#attributes' => [
      'class' => ['post-composer-advanced', 'is-collapsed'],
      'id' => 'post-composer-advanced-settings',
    ],
    '#weight' => 20,
  ];

  $form['advanced_settings']['advanced_title'] = [
    '#type' => 'markup',
    '#markup' => '<div class="post-advanced-heading"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> <span>' . t('Advanced Configuration & Metadata') . '</span></div>',
    '#weight' => -50,
  ];

  $advanced_keys = [
    'footer',
    'status',
    'langcode',
    'field_tags',
    'path',
    'field_comments_without_title',
    'scheduler_settings',
    'publish_on',
    'unpublish_on',
    'publish_status',
    'publish_state',
    'unpublish_state',
    'url_redirects',
    'advanced',
  ];

  foreach ($advanced_keys as $key) {
    if (isset($form[$key])) {
      $form['advanced_settings'][$key] = $form[$key];
      unset($form[$key]);
    }
  }

  // Ensure actions stay at the bottom.
  if (isset($form['actions'])) {
    $form['actions']['#weight'] = 100;
  }
}

/**
 * Helper to streamline content node forms (Event, Theyyam, Location).
 */
function kaliyattam_subtheme_alter_content_node_form(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $bundle): void {
  // Attach the dedicated node-form library.
  $form['#attached']['library'][] = 'kaliyattam_subtheme/node-form';
  $form['#attributes']['class'][] = 'node-form--styled';
  $form['#attributes']['class'][] = 'node-form--' . $bundle;

  // Bundle specific field ordering and weight optimization.
  switch ($bundle) {
    case 'event':
      if (isset($form['title'])) $form['title']['#weight'] = 1;
      if (isset($form['field_when'])) $form['field_when']['#weight'] = 2;
      if (isset($form['field_where'])) $form['field_where']['#weight'] = 3;
      if (isset($form['field_content'])) $form['field_content']['#weight'] = 4;
      if (isset($form['field_media'])) $form['field_media']['#weight'] = 5;
      break;

    case 'theyyam':
      if (isset($form['title'])) $form['title']['#weight'] = 1;
      if (isset($form['body'])) $form['body']['#weight'] = 2;
      if (isset($form['field_featured_image'])) $form['field_featured_image']['#weight'] = 3;
      if (isset($form['field_media'])) $form['field_media']['#weight'] = 4;
      if (isset($form['field_tags'])) $form['field_tags']['#weight'] = 5;
      break;

    case 'location':
      if (isset($form['title'])) $form['title']['#weight'] = 1;
      if (isset($form['field_location_address'])) $form['field_location_address']['#weight'] = 2;
      if (isset($form['field_location_telephone'])) $form['field_location_telephone']['#weight'] = 3;
      if (isset($form['body'])) $form['body']['#weight'] = 4;
      if (isset($form['field_featured_image'])) $form['field_featured_image']['#weight'] = 5;
      if (isset($form['field_media'])) $form['field_media']['#weight'] = 6;
      if (isset($form['field_theyyam'])) $form['field_theyyam']['#weight'] = 7;
      break;
  }

  // Advanced toggle button bar.
  $form['advanced_toggle_bar'] = [
    '#type' => 'inline_template',
    '#template' => '
      <div class="node-form-advanced-bar">
        <button type="button" class="node-form-advanced-toggle" aria-expanded="false" title="' . t('Toggle secondary and administrative options') . '">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>' . t('Advanced Options') . '</span>
          <span class="toggle-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </button>
        <span class="node-form-advanced-hint">' . t('Language, publishing status, URL alias, and metadata') . '</span>
      </div>
    ',
    '#weight' => 40,
  ];

  // Collapsible Advanced drawer container.
  $form['advanced_drawer'] = [
    '#type' => 'container',
    '#tree' => FALSE,
    '#attributes' => [
      'class' => ['node-form-advanced', 'is-collapsed'],
      'id' => 'node-form-advanced-' . $bundle,
    ],
    '#weight' => 45,
  ];

  $form['advanced_drawer']['advanced_title'] = [
    '#type' => 'markup',
    '#markup' => '<div class="advanced-header"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> <span>' . t('Advanced Configuration & Metadata') . '</span></div>',
    '#weight' => -50,
  ];

  // Secondary keys to group under Advanced.
  $advanced_keys = [
    'footer',
    'status',
    'langcode',
    'field_comments',
    'path',
    'scheduler_settings',
    'publish_on',
    'unpublish_on',
    'publish_status',
    'publish_state',
    'unpublish_state',
    'url_redirects',
    'author',
    'uid',
    'created',
    'promotion',
    'promote',
    'sticky',
    'revision_information',
    'revision_log',
    'advanced',
  ];

  // For location bundle, also move geofield coordinates to advanced.
  if ($bundle === 'location') {
    $advanced_keys[] = 'field_geofield';
  }

  foreach ($advanced_keys as $key) {
    if (isset($form[$key])) {
      $form['advanced_drawer'][$key] = $form[$key];
      unset($form[$key]);
    }
  }

  // Customize submit actions.
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'][] = 'button--primary';
  }
  if (isset($form['actions'])) {
    $form['actions']['#weight'] = 100;
  }
}

/**
 * Implements hook_preprocess_menu_local_task().
 */
function kaliyattam_subtheme_preprocess_menu_local_task(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');
  if (is_string($node) || is_numeric($node)) {
    $node = \Drupal\node\Entity\Node::load($node);
  }
  // Suppress timeline tab on non-container nodes (post, page, etc.).
  if ($node instanceof \Drupal\node\NodeInterface && !in_array($node->bundle(), ['location', 'theyyam', 'event'], TRUE)) {
    if (!empty($variables['link']['#url'])) {
      try {
        $url_str = $variables['link']['#url']->toString();
        if (str_contains($url_str, '/timeline')) {
          $variables['hide_tab'] = TRUE;
        }
      }
      catch (\Exception $e) {}
    }
  }

  // Rename Revisions tab to Edit history on Wiki content types (location, theyyam).
  if ($node instanceof \Drupal\node\NodeInterface && in_array($node->bundle(), ['location', 'theyyam'], TRUE)) {
    if (!empty($variables['link']['#url'])) {
      try {
        $url_str = $variables['link']['#url']->toString();
        if (str_contains($url_str, '/revisions')) {
          $variables['link']['#title'] = t('Edit history');
        }
      }
      catch (\Exception $e) {}
    }
  }
}

/**
 * Implements hook_preprocess_menu_local_tasks().
 */
function kaliyattam_subtheme_preprocess_menu_local_tasks(array &$variables): void {
  // Suppress duplicate local tasks toolbar on events views to keep unified timeline-tabs-bar.
  $current_path = \Drupal::service('path.current')->getPath();
  $current_route = \Drupal::routeMatch()->getRouteName();
  if (str_starts_with($current_path, '/events') || str_starts_with((string) $current_route, 'view.events')) {
    unset($variables['primary']);
    return;
  }

  $active_tab_title = '';
  $is_admin_action = FALSE;

  $is_canonical_view = in_array($current_route, [
    'entity.node.canonical',
    'entity.taxonomy_term.canonical',
    'entity.user.canonical',
  ], TRUE);

  $current_node = \Drupal::routeMatch()->getParameter('node');
  if (is_string($current_node) || is_numeric($current_node)) {
    $current_node = \Drupal\node\Entity\Node::load($current_node);
  }

  if (!empty($variables['primary'])) {
    foreach (\Drupal\Core\Render\Element::children($variables['primary']) as $key) {
      $item = $variables['primary'][$key];

      // Omit timeline tab on non-container nodes (posts, pages).
      if ($current_node instanceof \Drupal\node\NodeInterface && !in_array($current_node->bundle(), ['location', 'theyyam', 'event'], TRUE)) {
        if (!empty($item['#link']['url'])) {
          try {
            $url_str = $item['#link']['url']->toString();
            if (str_contains($url_str, '/timeline')) {
              unset($variables['primary'][$key]);
              continue;
            }
          }
          catch (\Exception $e) {}
        }
      }

      // Rename Revisions tab to Edit history on Wiki content types (location, theyyam).
      if ($current_node instanceof \Drupal\node\NodeInterface && in_array($current_node->bundle(), ['location', 'theyyam'], TRUE)) {
        if (!empty($item['#link']['url'])) {
          try {
            $url_str = $item['#link']['url']->toString();
            if (str_contains($url_str, '/revisions') || ($item['#link']['title'] ?? '') === 'Revisions') {
              $variables['primary'][$key]['#link']['title'] = t('Edit history');
            }
          }
          catch (\Exception $e) {}
        }
      }

      // Consolidate timeline tabs: omit redundant location-timeline tab in favor of unified /node/{id}/timeline.
      if (!empty($item['#link']['url'])) {
        try {
          $url_str = $item['#link']['url']->toString();
          if (str_contains($url_str, 'location-timeline')) {
            unset($variables['primary'][$key]);
            continue;
          }
        }
        catch (\Exception $e) {
          // Fall through.
        }
      }

      if (!empty($item['#active'])) {
        $title = !empty($item['#link']['title']) ? (string) $item['#link']['title'] : '';
        $active_tab_title = $title;
        $title_lower = mb_strtolower(trim($title));
        // Keep collapsed on standard public "View" tab, open on admin actions.
        $is_view_tab = in_array($title_lower, ['view', 'കാഴ്ച', 'കാണുക', 'വിവരങ്ങൾ'], TRUE);
        if (!$is_canonical_view && !$is_view_tab) {
          $is_admin_action = TRUE;
        }
      }
    }
  }

  // Resolve node from current internal path if not already loaded by route match.
  if (!$current_node instanceof \Drupal\node\NodeInterface) {
    try {
      $path = \Drupal::service('path.current')->getPath();
      if (preg_match('#^/node/(\d+)#', $path, $matches)) {
        $current_node = \Drupal\node\Entity\Node::load($matches[1]);
      }
    }
    catch (\Exception $e) {}
  }

  // Build Wikipedia-style vector-page-toolbar for Theyyam and Temple (Location) content types.
  if ($current_node instanceof \Drupal\node\NodeInterface && in_array($current_node->bundle(), ['location', 'theyyam'], TRUE)) {
    $bundle = $current_node->bundle();
    $canonical_url = $current_node->toUrl('canonical')->toString();
    $timeline_url = $canonical_url . '/timeline';
    $edit_url = \Drupal::currentUser()->isAuthenticated()
      ? $current_node->toUrl('edit-form')->toString()
      : \Drupal\Core\Url::fromRoute('user.login', [], ['query' => ['destination' => $current_node->toUrl('edit-form')->toString()]])->toString();
    $history_url = \Drupal\Core\Url::fromRoute('entity.node.version_history', ['node' => $current_node->id()])->toString();

    $route_name = \Drupal::routeMatch()->getRouteName();
    $path_info = \Drupal::request()->getPathInfo();

    $is_timeline = (strpos($route_name, 'timeline') !== FALSE || str_ends_with($path_info, '/timeline'));
    $is_edit = ($route_name === 'entity.node.edit_form');
    $is_history = ($route_name === 'entity.node.version_history' || str_contains($path_info, '/revisions'));
    $is_view = (!$is_timeline && !$is_edit && !$is_history && $route_name === 'entity.node.canonical');

    $extra_tabs = [];
    if (!empty($variables['primary'])) {
      foreach (\Drupal\Core\Render\Element::children($variables['primary']) as $key) {
        $item = $variables['primary'][$key];
        if (!empty($item['#link']['url'])) {
          try {
            $url_str = $item['#link']['url']->toString();
            $title = !empty($item['#link']['title']) ? (string) $item['#link']['title'] : '';
            $title_lower = mb_strtolower(trim($title));
            if (!str_contains($url_str, '/timeline') && !str_contains($url_str, '/edit') && !str_contains($url_str, '/revisions') && !in_array($title_lower, ['view', 'കാഴ്ച', 'കാണുക', 'വിവരങ്ങൾ'])) {
              $extra_tabs[] = [
                'title' => $title,
                'url' => $url_str,
                'is_active' => !empty($item['#active']),
              ];
            }
          }
          catch (\Exception $e) {}
        }
      }
    }

    $variables['is_wiki_toolbar'] = TRUE;
    $variables['wiki_bundle_label'] = ($bundle === 'theyyam') ? t('Theyyam') : t('Temple');
    $variables['wiki_invite_text'] = t('You are invited to edit and improve this and other pages');
    $wiki_tabs = [
      'view' => [
        'title' => t('View'),
        'url' => $canonical_url,
        'is_active' => $is_view,
      ],
    ];

    if ($bundle === 'location') {
      $wiki_tabs['map'] = [
        'title' => t('Map'),
        'url' => $canonical_url . '#temple-map',
        'is_active' => FALSE,
      ];
    }

    $wiki_tabs['timeline'] = [
      'title' => t('Timeline'),
      'url' => $timeline_url,
      'is_active' => $is_timeline,
    ];
    $wiki_tabs['edit'] = [
      'title' => t('Edit'),
      'url' => $edit_url,
      'is_active' => $is_edit,
    ];
    $wiki_tabs['history'] = [
      'title' => t('History'),
      'url' => $history_url,
      'is_active' => $is_history,
    ];

    $variables['wiki_tabs'] = $wiki_tabs;
    $variables['wiki_extra_tabs'] = $extra_tabs;
  }

  // Open tabs drawer by default when a public Timeline or Edit history tab is present.
  $has_public_extra_tabs = FALSE;
  if (!empty($variables['primary'])) {
    foreach (\Drupal\Core\Render\Element::children($variables['primary']) as $key) {
      $item = $variables['primary'][$key];
      if (!empty($item['#link']['url'])) {
        try {
          $url_str = $item['#link']['url']->toString();
          if (str_contains($url_str, '/timeline') || str_contains($url_str, '/revisions')) {
            $has_public_extra_tabs = TRUE;
            break;
          }
        }
        catch (\Exception $e) {}
      }
    }
  }

  $variables['active_tab_title'] = $active_tab_title;
  $variables['tasks_open'] = $is_admin_action || $has_public_extra_tabs;
}




/**
 * Implements hook_preprocess_views_view().
 */
function kaliyattam_subtheme_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  $view_id = $view->id();
  $display_id = $view->current_display;

  // Add standard Drupal view CSS classes to attributes.
  $variables['attributes']['class'][] = 'view';
  $variables['attributes']['class'][] = 'view-' . \Drupal\Component\Utility\Html::cleanCssIdentifier($view_id);
  $variables['attributes']['class'][] = 'view-id-' . $view_id;
  $variables['attributes']['class'][] = 'view-display-id-' . $display_id;

  // Event Date Archives & Hub navigation toolbar: unified across /events, /events/past, /events/calendar, /events/YYYY, /events/YYYY/MM, /events/YYYY/MM/DD.
  $is_events_view = ($view_id === 'events' && in_array($display_id, ['page_1', 'page_2', 'page_year', 'page_month', 'page_day'], TRUE));
  $is_events_calendar = ($view_id === 'events_calendar');
  if ($is_events_view || $is_events_calendar) {
    $args = $view->args;
    $is_calendar = $is_events_calendar;
    $is_upcoming = ($view_id === 'events' && ($display_id === 'page_1' || ($display_id === 'page_year' && ($args[0] ?? '') === 'upcoming')));
    $is_past = ($view_id === 'events' && ($display_id === 'page_2' || ($display_id === 'page_year' && ($args[0] ?? '') === 'past')));
    $is_by_date = ($view_id === 'events' && in_array($display_id, ['page_year', 'page_month', 'page_day'], TRUE) && !$is_upcoming && !$is_past);

    $year = is_numeric($args[0] ?? '') ? (int) $args[0] : (int) date('Y');
    $active_month = ($is_upcoming || $is_past || $is_calendar) ? -1 : (int) ($args[1] ?? 0);
    $active_day = ($is_upcoming || $is_past || $is_calendar) ? 0 : (int) ($args[2] ?? 0);

    $months = [
      1 => t('Jan'), 2 => t('Feb'), 3 => t('Mar'), 4 => t('Apr'),
      5 => t('May'), 6 => t('Jun'), 7 => t('Jul'), 8 => t('Aug'),
      9 => t('Sep'), 10 => t('Oct'), 11 => t('Nov'), 12 => t('Dec'),
    ];

    $month_pills = '';
    foreach ($months as $m_num => $m_label) {
      $m_pad = sprintf('%02d', $m_num);
      $is_active = ($active_month === $m_num);
      $month_pills .= '<a href="/events/' . $year . '/' . $m_pad . '" class="events-date-pill' . ($is_active ? ' is-active' : '') . '" title="' . $m_pad . ' (' . $m_label . ')"><span class="events-date-pill-num">' . $m_pad . '</span> <span class="events-date-pill-name">' . $m_label . '</span></a>';
    }

    $day_badge = '';
    if ($active_day > 0) {
      $day_pad = sprintf('%02d', $active_day);
      $day_badge = '<span class="events-date-day-badge ms-2"><i class="bi bi-calendar-check me-1"></i>' . t('Day @day', ['@day' => $day_pad]) . '</span>';
    }

    $show_months = ($display_id === 'page_year' || $display_id === 'page_month' || $display_id === 'page_day') && !$is_upcoming && !$is_past;
    $has_search = !empty(\Drupal::request()->query->get('search'));

    $tabs_html = '
      <div class="timeline-tabs-bar-wrapper">
        <div class="timeline-tabs-bar">
          <nav class="timeline-nav-tabs" aria-label="' . t('Events Navigation') . '">
            <a href="/events" class="timeline-nav-tab' . ($is_upcoming ? ' is-active' : '') . '" data-tab="upcoming">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span class="tab-label">' . t('Upcoming') . '</span>
            </a>
            <a href="/events/calendar" class="timeline-nav-tab' . ($is_calendar ? ' is-active' : '') . '" data-tab="calendar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span class="tab-label">' . t('Calendar') . '</span>
            </a>
            <a href="/events/past" class="timeline-nav-tab' . ($is_past ? ' is-active' : '') . '" data-tab="past">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
              <span class="tab-label">' . t('Archive') . '</span>
            </a>
            ' . ($is_by_date ? '
            <a href="/events/' . $year . '" class="timeline-nav-tab is-active" data-tab="year">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <span class="tab-label">' . $year . '</span>
            </a>' : '') . '
            <button type="button" class="timeline-nav-tab timeline-nav-tab--search' . ($has_search ? ' is-active' : '') . '" data-tab="search" aria-label="' . t('Toggle search filters') . '" aria-expanded="' . ($has_search ? 'true' : 'false') . '">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span class="tab-label">' . t('Search') . '</span>
            </button>
          </nav>
          <div class="timeline-tabs-actions">
            ' . $day_badge . '
          </div>
        </div>
        ' . ($show_months ? '
        <nav class="events-months-nav d-flex flex-wrap gap-1 mt-2 pt-2 border-top" aria-label="' . t('Filter by month in @year', ['@year' => $year]) . '">
          <a href="/events/' . $year . '" class="events-date-pill events-date-pill--all' . ($active_month === 0 ? ' is-active' : '') . '">' . t('All Year') . '</a>
          ' . $month_pills . '
        </nav>' : '') . '
      </div>';

    $variables['header']['event_date_nav'] = [
      '#type' => 'inline_template',
      '#template' => $tabs_html,
      '#weight' => -10,
    ];
  }

  // Process timeline feeds and specialized lists (timeline_*, locations_map).
  if (str_starts_with($view_id, 'timeline_') || $view_id === 'locations_map') {
    // Skip attachment displays (e.g., attachment_pinned) to prevent duplicate headers.
    if ($view->display_handler && $view->display_handler->getPluginId() === 'attachment') {
      return;
    }

    $request = \Drupal::request();
    $params = $request->query->all();

    // 1. Events Timeline: tabs [New], [Top], [Upcoming], [Past], [Calendar], [Search], [Joined], [Following]
    if ($view_id === 'timeline_events' && $display_id === 'page_events') {
      $when = $params['when'] ?? '';
      $sort_newest = $params['sort_newest'] ?? '';
      $sort_by = $params['sort_by'] ?? '';
      $sort_bef_combine = $params['sort_bef_combine'] ?? '';
      $favorites = $params['favorites'] ?? '';
      $place = $params['place'] ?? '';
      $search = $params['search'] ?? '';

      $active_tab = 'upcoming';
      if (!empty($sort_newest) || str_contains($sort_by, 'newest') || str_starts_with($sort_bef_combine, 'created_DESC')) {
        $active_tab = 'new';
      }
      elseif ($when == '3' && !empty($favorites)) {
        $active_tab = 'top';
      }
      elseif ($when == '2') {
        $active_tab = 'past';
      }
      elseif ($when == '1') {
        $active_tab = 'upcoming';
      }
      elseif (!empty($favorites)) {
        $active_tab = 'joined';
      }
      elseif (!empty($place) || !empty($search)) {
        $active_tab = 'search';
      }

      $tabs_html = '
        <div class="timeline-tabs-bar-wrapper">
          <div class="timeline-tabs-bar">
            <nav class="timeline-nav-tabs" aria-label="' . t('Events Timeline Navigation') . '">
              <a href="/timeline/events?when=3&sort_newest=DESC" class="timeline-nav-tab' . ($active_tab === 'new' ? ' is-active' : '') . '" data-tab="new">
                <span class="tab-label">' . t('New') . '</span>
              </a>
              <a href="/timeline/events?when=3&favorites=1" class="timeline-nav-tab' . ($active_tab === 'top' ? ' is-active' : '') . '" data-tab="top">
                <span class="tab-label">' . t('Top') . '</span>
              </a>
              <a href="/timeline/events?when=1" class="timeline-nav-tab' . ($active_tab === 'upcoming' ? ' is-active' : '') . '" data-tab="upcoming">
                <span class="tab-label">' . t('Upcoming') . '</span>
              </a>
              <a href="/timeline/events?when=2" class="timeline-nav-tab' . ($active_tab === 'past' ? ' is-active' : '') . '" data-tab="past">
                <span class="tab-label">' . t('Past') . '</span>
              </a>
              <a href="/events/calendar" class="timeline-nav-tab" data-tab="calendar">
                <span class="tab-label">' . t('Calendar') . '</span>
              </a>
              <button type="button" class="timeline-nav-tab timeline-nav-tab--search' . ($active_tab === 'search' ? ' is-active' : '') . '" data-tab="search" aria-label="' . t('Toggle search filters') . '" aria-expanded="' . ($active_tab === 'search' ? 'true' : 'false') . '">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <span class="tab-label">' . t('Search') . '</span>
              </button>
              <a href="/timeline/events?favorites=1" class="timeline-nav-tab' . ($active_tab === 'joined' ? ' is-active' : '') . '" data-tab="joined">
                <span class="tab-label">' . t('Joined') . '</span>
              </a>
              <a href="/timeline/events?favorites=1" class="timeline-nav-tab' . ($active_tab === 'following' ? ' is-active' : '') . '" data-tab="following">
                <span class="tab-label">' . t('Following') . '</span>
              </a>
            </nav>
            <div class="timeline-tabs-actions">
              <div id="near-me-toggle-wrapper" class="near-me-wrapper">
                <button type="button" id="btn-near-me" class="btn-near-me" aria-label="' . t('Find events near me') . '">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="12 8 8 12 12 16 12 8"/></svg>
                  <span>' . t('Near Me') . '</span>
                </button>
                <span id="near-me-status" class="near-me-status"></span>
              </div>
              <div class="timeline-view-switcher" role="group" aria-label="' . t('Layout view switcher') . '">
                <button type="button" class="view-switch-btn is-active" data-layout="grid" title="' . t('Grid view') . '" aria-label="' . t('Grid view') . '" aria-pressed="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  <span class="switcher-text">' . t('Grid') . '</span>
                </button>
                <button type="button" class="view-switch-btn" data-layout="list" title="' . t('List view') . '" aria-label="' . t('List view') . '" aria-pressed="false">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                  <span class="switcher-text">' . t('List') . '</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      ';

      $variables['header']['events_nav'] = [
        '#type' => 'inline_template',
        '#template' => $tabs_html,
        '#weight' => -10,
      ];
    }
    // 2. Sitewide Timeline (/timeline): tabs [Latest], [Popular], [Search] + Grid/List Switcher
    elseif ($view_id === 'timeline_site') {
      $sort_bef = $params['sort_bef_combine'] ?? '';
      $search = $params['search'] ?? '';
      $type = $params['type'] ?? '';

      $active_tab = 'latest';
      if ($sort_bef === 'count_DESC') {
        $active_tab = 'popular';
      }
      elseif (!empty($search) || (!empty($type) && $type !== 'All')) {
        $active_tab = 'search';
      }

      $tabs_html = '
        <div class="timeline-tabs-bar-wrapper">
          <div class="timeline-tabs-bar">
            <nav class="timeline-nav-tabs" aria-label="' . t('Timeline Navigation') . '">
              <a href="/timeline" class="timeline-nav-tab' . ($active_tab === 'latest' ? ' is-active' : '') . '" data-tab="latest">
                <span class="tab-label">' . t('Latest') . '</span>
              </a>
              <a href="/timeline?sort_bef_combine=count_DESC" class="timeline-nav-tab' . ($active_tab === 'popular' ? ' is-active' : '') . '" data-tab="popular">
                <span class="tab-label">' . t('Popular') . '</span>
              </a>
              <button type="button" class="timeline-nav-tab timeline-nav-tab--search' . ($active_tab === 'search' ? ' is-active' : '') . '" data-tab="search" aria-label="' . t('Toggle search filters') . '" aria-expanded="' . ($active_tab === 'search' ? 'true' : 'false') . '">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <span class="tab-label">' . t('Search') . '</span>
              </button>
            </nav>
            <div class="timeline-tabs-actions">
              <div class="timeline-view-switcher" role="group" aria-label="' . t('Layout view switcher') . '">
                <button type="button" class="view-switch-btn is-active" data-layout="grid" title="' . t('Grid view') . '" aria-label="' . t('Grid view') . '" aria-pressed="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  <span class="switcher-text">' . t('Grid') . '</span>
                </button>
                <button type="button" class="view-switch-btn" data-layout="list" title="' . t('List view') . '" aria-label="' . t('List view') . '" aria-pressed="false">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                  <span class="switcher-text">' . t('List') . '</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      ';

      $variables['header']['timeline_site_nav'] = [
        '#type' => 'inline_template',
        '#template' => $tabs_html,
        '#weight' => -10,
      ];
    }
    // 3. Locations / Temples (/temples & /temples/map): tabs [List View], [Map View], [Search] + Near Me + Switcher
    elseif ($view_id === 'timeline_locations' || $view_id === 'locations_map') {
      unset($variables['header']['area']);
      $is_map = ($view_id === 'locations_map');
      $is_list = !$is_map;
      $search = $params['search'] ?? '';

      $tabs_html = '
        <div class="timeline-tabs-bar-wrapper">
          <div class="timeline-tabs-bar">
            <nav class="timeline-nav-tabs" aria-label="' . t('Temples Navigation') . '">
              <a href="/temples" class="timeline-nav-tab' . ($is_list ? ' is-active' : '') . '" data-tab="list">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                <span class="tab-label">' . t('List View') . '</span>
              </a>
              <a href="/temples/map" class="timeline-nav-tab' . ($is_map ? ' is-active' : '') . '" data-tab="map">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                <span class="tab-label">' . t('Map View') . '</span>
              </a>
              <button type="button" class="timeline-nav-tab timeline-nav-tab--search' . (!empty($search) ? ' is-active' : '') . '" data-tab="search" aria-label="' . t('Toggle search filters') . '" aria-expanded="' . (!empty($search) ? 'true' : 'false') . '">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <span class="tab-label">' . t('Search') . '</span>
              </button>
            </nav>
            <div class="timeline-tabs-actions">
              <div id="near-me-toggle-wrapper" class="near-me-wrapper">
                <button type="button" id="btn-near-me" class="btn-near-me" aria-label="' . t('Find temples near me') . '">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="12 8 8 12 12 16 12 8"/></svg>
                  <span>' . t('Near Me') . '</span>
                </button>
                <span id="near-me-status" class="near-me-status"></span>
              </div>
              ' . ($is_list ? '
              <div class="timeline-view-switcher" role="group" aria-label="' . t('Layout view switcher') . '">
                <button type="button" class="view-switch-btn is-active" data-layout="grid" title="' . t('Grid view') . '" aria-label="' . t('Grid view') . '" aria-pressed="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  <span class="switcher-text">' . t('Grid') . '</span>
                </button>
                <button type="button" class="view-switch-btn" data-layout="list" title="' . t('List view') . '" aria-label="' . t('List view') . '" aria-pressed="false">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                  <span class="switcher-text">' . t('List') . '</span>
                </button>
              </div>' : '') . '
            </div>
          </div>
        </div>
      ';

      $variables['header']['locations_nav'] = [
        '#type' => 'inline_template',
        '#template' => $tabs_html,
        '#weight' => -10,
      ];
    }
    // 4. Theyyam Timeline (/theyyam): tabs [Latest], [Recently Updated], [Popular], [Search] + Switcher
    elseif ($view_id === 'timeline_type' && $display_id === 'theyyam_page') {
      $sort_by = $params['sort_by'] ?? '';
      $search = $params['search'] ?? '';

      $active_tab = 'latest';
      if ($sort_by === 'changed') {
        $active_tab = 'changed';
      }
      elseif ($sort_by === 'count' || $sort_by === 'sort_favorite') {
        $active_tab = 'popular';
      }
      elseif (!empty($search)) {
        $active_tab = 'search';
      }

      $tabs_html = '
        <div class="timeline-tabs-bar-wrapper">
          <div class="timeline-tabs-bar">
            <nav class="timeline-nav-tabs" aria-label="' . t('Theyyam Navigation') . '">
              <a href="/theyyam" class="timeline-nav-tab' . ($active_tab === 'latest' ? ' is-active' : '') . '" data-tab="latest">
                <span class="tab-label">' . t('Latest') . '</span>
              </a>
              <a href="/theyyam?sort_by=changed" class="timeline-nav-tab' . ($active_tab === 'changed' ? ' is-active' : '') . '" data-tab="changed">
                <span class="tab-label">' . t('Recently Updated') . '</span>
              </a>
              <a href="/theyyam?sort_by=count" class="timeline-nav-tab' . ($active_tab === 'popular' ? ' is-active' : '') . '" data-tab="popular">
                <span class="tab-label">' . t('Popular') . '</span>
              </a>
              <button type="button" class="timeline-nav-tab timeline-nav-tab--search' . ($active_tab === 'search' ? ' is-active' : '') . '" data-tab="search" aria-label="' . t('Toggle search filters') . '" aria-expanded="' . ($active_tab === 'search' ? 'true' : 'false') . '">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
