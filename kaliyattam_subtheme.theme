                <button type="button" class="view-switch-btn" data-layout="list" title="' . t('List view') . '" aria-label="' . t('List view') . '" aria-pressed="false">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                  <span class="switcher-text">' . t('List') . '</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      ';

      $variables['header']['theyyam_nav'] = [
        '#type' => 'inline_template',
        '#template' => $tabs_html,
        '#weight' => -10,
      ];
    }
    // 5. Posts Timeline (/posts): tabs [Latest], [Recently Updated], [Popular], [Search] + Switcher
    elseif ($view_id === 'timeline_type' && $display_id === 'post_page') {
      $sort_by = $params['sort_by'] ?? '';
      $search = $params['search'] ?? '';

      $active_tab = 'latest';
      if ($sort_by === 'changed') {
        $active_tab = 'changed';
      }
      elseif ($sort_by === 'count' || $sort_by === 'sort_favorite') {
        $active_tab = 'popular';
      }
      elseif (!empty($search)) {
        $active_tab = 'search';
      }

      $tabs_html = '
        <div class="timeline-tabs-bar-wrapper">
          <div class="timeline-tabs-bar">
            <nav class="timeline-nav-tabs" aria-label="' . t('Posts Navigation') . '">
              <a href="/posts" class="timeline-nav-tab' . ($active_tab === 'latest' ? ' is-active' : '') . '" data-tab="latest">
                <span class="tab-label">' . t('Latest') . '</span>
