            <div class="timeline-tabs-actions">
              <div class="timeline-view-switcher" role="group" aria-label="' . t('Layout view switcher') . '">
                <button type="button" class="view-switch-btn is-active" data-layout="grid" title="' . t('Grid view') . '" aria-label="' . t('Grid view') . '" aria-pressed="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  <span class="switcher-text">' . t('Grid') . '</span>
                </button>
                <button type="button" class="view-switch-btn" data-layout="list" title="' . t('List view') . '" aria-label="' . t('List view') . '" aria-pressed="false">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                  <span class="switcher-text">' . t('List') . '</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      ';

      $variables['header']['posts_nav'] = [
        '#type' => 'inline_template',
        '#template' => $tabs_html,
        '#weight' => -10,
      ];
    }
    // 6. Other timelines: Location node timeline, User timeline, etc.
    else {
      $tabs_html = '
        <div class="timeline-tabs-bar-wrapper timeline-tabs-bar-wrapper--compact">
          <div class="timeline-tabs-bar">
            <div class="timeline-tabs-spacer"></div>
            <div class="timeline-tabs-actions">
              <div class="timeline-view-switcher" role="group" aria-label="' . t('Layout view switcher') . '">
                <button type="button" class="view-switch-btn is-active" data-layout="grid" title="' . t('Grid view') . '" aria-label="' . t('Grid view') . '" aria-pressed="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                  <span class="switcher-text">' . t('Grid') . '</span>
                </button>
                <button type="button" class="view-switch-btn" data-layout="list" title="' . t('List view') . '" aria-label="' . t('List view') . '" aria-pressed="false">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><circle cx="4" cy="6" r="1.5" fill="currentColor"></circle><circle cx="4" cy="12" r="1.5" fill="currentColor"></circle><circle cx="4" cy="18" r="1.5" fill="currentColor"></circle></svg>
                  <span class="switcher-text">' . t('List') . '</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      ';

      $variables['header']['timeline_generic_nav'] = [
        '#type' => 'inline_template',
        '#template' => $tabs_html,
        '#weight' => -10,
      ];
    }
  }
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function kaliyattam_subtheme_preprocess_breadcrumb(array &$variables): void {
  if (empty($variables['breadcrumb'])) {
    return;
  }

  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');
  if (is_string($node) || is_numeric($node)) {
    $node = \Drupal\node\Entity\Node::load($node);
  }

  // Format breadcrumbs for posts: Home > alice > posts > 2026 > 10 > 02 > [node_id].
  if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'post') {
    $created_time = (int) $node->getCreatedTime();
    $year = date('Y', $created_time);
    $month = date('m', $created_time);
    $day = date('d', $created_time);
    $nid = $node->id();
    $author = $node->getOwner();
    $author_name = $author ? $author->getDisplayName() : 'User';
    $author_uid = $author ? $author->id() : 1;

    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => '/',
      ],
      [
        'text' => $author_name,
        'url' => '/user/' . $author_uid . '/timeline?page=1',
      ],
      [
        'text' => t('posts'),
        'url' => '/posts',
      ],
      [
        'text' => $year,
        'url' => '/posts?year=' . $year,
      ],
      [
        'text' => $month,
        'url' => '/posts?year=' . $year . '&month=' . $month,
      ],
      [
        'text' => $day,
        'url' => '/posts?year=' . $year . '&month=' . $month . '&day=' . $day,
      ],
      [
        'text' => (string) $nid,
        'url' => '',
      ],
    ];
    return;
  }

  // Format breadcrumbs for events: Home > Events (/events) > YYYY (/events/YYYY) > MM (/events/YYYY/MM) > DD (/events/YYYY/MM/DD) > [cleaned title].
  if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'event') {
    $date_field = $node->hasField('field_when') && !$node->get('field_when')->isEmpty()
      ? $node->get('field_when')
      : ($node->hasField('field_event__date') && !$node->get('field_event__date')->isEmpty() ? $node->get('field_event__date') : NULL);

    if ($date_field) {
      $start_ts = (int) $date_field->value;
      $year = date('Y', $start_ts);
      $month_num = (int) date('n', $start_ts);
      $month_padded = sprintf('%02d', $month_num);
      $month_name = date('F', $start_ts);
      $day_num = (int) date('j', $start_ts);
      $day_padded = sprintf('%02d', $day_num);

      $raw_title = (string) $node->getTitle();
      $cleaned_title = trim($raw_title);
      if (mb_strlen($cleaned_title) > 35) {
        $cleaned_title = mb_substr($cleaned_title, 0, 32) . '…';
      }

      $variables['breadcrumb'] = [
        [
          'text' => t('Home'),
          'url' => '/',
        ],
        [
          'text' => t('Events'),
          'url' => '/events',
        ],
        [
          'text' => $year,
          'url' => '/events/' . $year,
        ],
        [
          'text' => $month_padded,
          'url' => '/events/' . $year . '/' . $month_padded,
        ],
        [
          'text' => $day_padded,
          'url' => '/events/' . $year . '/' . $month_padded . '/' . $day_padded,
        ],
        [
          'text' => $cleaned_title,
          'url' => '',
        ],
      ];
      return;
    }
  }

  $route_name = $route_match->getRouteName();

  // Format breadcrumbs for user timelines (/user/{uid}/timeline): Home > {User} > Timeline.
  if (in_array($route_name, ['view.timeline_user.page_timeline', 'entity.user.canonical', 'entity.user.edit_form'], TRUE)) {
    $user_param = $route_match->getParameter('user') ?? $route_match->getParameter('arg_0');
    $user_entity = is_numeric($user_param) ? \Drupal\user\Entity\User::load($user_param) : ($user_param instanceof \Drupal\user\UserInterface ? $user_param : NULL);
    $user_display_name = $user_entity ? $user_entity->getDisplayName() : ('User ' . $user_param);
    $user_uid = $user_entity ? $user_entity->id() : $user_param;

    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => '/',
      ],
      [
        'text' => $user_display_name,
        'url' => '/user/' . $user_uid . '/timeline?page=1',
      ],
      [
        'text' => t('Timeline'),
        'url' => '',
      ],
    ];
    return;
  }

  // Format breadcrumbs for event date archive views:
  // /events/YYYY -> Home > Events > YYYY
  // /events/YYYY/MM -> Home > Events > YYYY > MM
  // /events/YYYY/MM/DD -> Home > Events > YYYY > MM > DD
  if ($route_name === 'view.events.page_year') {
    $year = $route_match->getParameter('arg_0') ?? '';
    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => '/',
      ],
      [
        'text' => t('Events'),
        'url' => '/events',
      ],
      [
        'text' => (string) $year,
        'url' => '',
      ],
    ];
    return;
  }
  if ($route_name === 'view.events.page_month') {
    $year = $route_match->getParameter('arg_0') ?? '';
    $month = (int) ($route_match->getParameter('arg_1') ?? 0);
    $month_padded = sprintf('%02d', $month);
    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => '/',
      ],
      [
        'text' => t('Events'),
        'url' => '/events',
      ],
      [
        'text' => (string) $year,
        'url' => '/events/' . $year,
      ],
      [
        'text' => $month_padded,
        'url' => '',
      ],
    ];
    return;
  }
  if ($route_name === 'view.events.page_day') {
    $year = $route_match->getParameter('arg_0') ?? '';
    $month = (int) ($route_match->getParameter('arg_1') ?? 0);
    $day = (int) ($route_match->getParameter('arg_2') ?? 0);
    $month_padded = sprintf('%02d', $month);
    $day_padded = sprintf('%02d', $day);
    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => '/',
      ],
      [
        'text' => t('Events'),
        'url' => '/events',
      ],
      [
        'text' => (string) $year,
        'url' => '/events/' . $year,
      ],
      [
        'text' => $month_padded,
        'url' => '/events/' . $year . '/' . $month_padded,
      ],
      [
        'text' => $day_padded,
        'url' => '',
      ],
    ];
    return;
  }
  if ($route_name === 'view.timeline_theyyam.page_timeline') {
    $node = $route_match->getParameter('node');
    if (is_string($node) || is_numeric($node)) {
      $node = \Drupal\node\Entity\Node::load($node);
    }
    if ($node instanceof \Drupal\node\NodeInterface) {
      $bundle = $node->bundle();
      $node_title = $node->getTitle();
      $clean_title = mb_strlen($node_title) > 35 ? mb_substr($node_title, 0, 32) . '…' : $node_title;
      $canonical_url = $node->toUrl('canonical')->toString();

      if ($bundle === 'location') {
        $variables['breadcrumb'] = [
          ['text' => t('Home'), 'url' => '/'],
          ['text' => t('Temples'), 'url' => '/temples'],
          ['text' => $clean_title, 'url' => $canonical_url],
          ['text' => t('Timeline'), 'url' => ''],
        ];
        return;
      }
      elseif ($bundle === 'theyyam') {
        $variables['breadcrumb'] = [
          ['text' => t('Home'), 'url' => '/'],
          ['text' => t('Theyyam'), 'url' => '/theyyam'],
          ['text' => $clean_title, 'url' => $canonical_url],
          ['text' => t('Timeline'), 'url' => ''],
        ];
        return;
      }
      elseif ($bundle === 'event') {
        $variables['breadcrumb'] = [
          ['text' => t('Home'), 'url' => '/'],
          ['text' => t('Events'), 'url' => '/events'],
          ['text' => $clean_title, 'url' => $canonical_url],
          ['text' => t('Timeline'), 'url' => ''],
        ];
        return;
      }
    }
  }

  if ($route_name === 'view.events_calendar.page_1') {
    $variables['breadcrumb'] = [
      [
        'text' => t('Home'),
        'url' => '/',
      ],
      [
        'text' => t('Events'),
        'url' => '/events',
      ],
      [
        'text' => t('Calendar'),
        'url' => '',
      ],
    ];
    return;
  }
  if ($route_name && str_starts_with($route_name, 'view.timeline_type.')) {
    $type_labels = [
      'view.timeline_type.theyyam_page' => t('Theyyam'),
      'view.timeline_type.post_page' => t('Posts'),
      'view.timeline_type.location_page' => t('Places'),
      'view.timeline_type.event_page' => t('Events'),
    ];
    if (isset($type_labels[$route_name])) {
      $variables['breadcrumb'] = [
        [
          'text' => t('Home'),
          'url' => '/',
        ],
        [
          'text' => t('Timeline'),
          'url' => '/timeline',
        ],
        [
          'text' => $type_labels[$route_name],
          'url' => '',
        ],
      ];
      return;
    }
  }

  // For any other page, ensure long titles at the end of the breadcrumb are trimmed to a reasonable length.
  $last_index = count($variables['breadcrumb']) - 1;
  if ($last_index >= 0 && isset($variables['breadcrumb'][$last_index]['text'])) {
    $title_text = (string) $variables['breadcrumb'][$last_index]['text'];
    if (mb_strlen($title_text) > 40) {
      $variables['breadcrumb'][$last_index]['text'] = mb_substr($title_text, 0, 37) . '…';
    }
  }
}
