{#
/**
 * @file
 * Theme implementation to display a system branding block.
 */
#}
{% block content %}
  <div class="site-branding">
    {% if site_logo %}
      <a href="{{ path('<front>') }}" rel="home" class="site-logo" aria-label="{{ 'Return to home'|t }}">
        <img src="{{ site_logo }}" alt="{{ site_name ?: 'Home'|t }}" fetchpriority="high" />
      </a>
    {% endif %}
    {% if site_name or site_slogan %}
      <div class="site-branding-text">
        {% if site_name %}
          <a href="{{ path('<front>') }}" rel="home" class="site-title">{{ site_name }}</a>
        {% endif %}
        {% if site_slogan %}
          <div class="site-slogan">{{ site_slogan }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endblock %}
