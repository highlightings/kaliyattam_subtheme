{#
/**
 * @file
 * Kaliyattam Subtheme implementation for subtle and collapsible local tasks.
 *
 * Available variables:
 * - primary: HTML list items representing primary tasks.
 * - secondary: HTML list items representing secondary tasks.
 * - active_tab_title: The title of the currently active tab.
 * - tasks_open: Boolean indicating if details should be open by default.
 */
#}
{% if is_wiki_toolbar %}
  <div class="vector-page-toolbar">
    <div class="vector-page-toolbar-container">
      <div id="left-navigation">
        <nav aria-label="{{ 'Namespaces'|t }}">
          <div id="p-associated-pages" class="vector-menu vector-menu-tabs mw-portlet mw-portlet-associated-pages">
            <div class="vector-menu-content">
              <ul class="vector-menu-content-list">
                <li id="ca-nstab-main" class="selected is-active mw-list-item vector-tab-noicon">
                  <a href="{{ wiki_tabs.view.url }}"><span>{{ wiki_bundle_label }}</span></a>
                </li>
              </ul>
            </div>
          </div>
        </nav>
        <div class="vector-wiki-invite-line" title="{{ 'Community contribution'|t }}">
          <i class="bi bi-pencil-square" aria-hidden="true"></i>
          <span class="invite-text">{{ wiki_invite_text }}</span>
        </div>
      </div>
      <div id="right-navigation" class="vector-collapsible">
        <nav aria-label="{{ 'Views'|t }}">
          <div id="p-views" class="vector-menu vector-menu-tabs mw-portlet mw-portlet-views">
            <div class="vector-menu-content">
              <ul class="vector-menu-content-list tabs tabs--primary">
                <li id="ca-view" class="mw-list-item vector-tab-noicon {% if wiki_tabs.view.is_active %}selected is-active{% endif %}">
                  <a href="{{ wiki_tabs.view.url }}" class="{% if wiki_tabs.view.is_active %}is-active{% endif %}">
                    <span>{{ 'View'|t }}</span>
                  </a>
                </li>
                {% if wiki_tabs.map is defined %}
                  <li id="ca-map" class="mw-list-item vector-tab-noicon {% if wiki_tabs.map.is_active %}selected is-active{% endif %}">
                    <a href="{{ wiki_tabs.map.url }}" class="{% if wiki_tabs.map.is_active %}is-active{% endif %}" title="{{ 'View temple location on map'|t }}">
                      <span>{{ 'Map'|t }}</span>
                    </a>
                  </li>
                {% endif %}
                <li id="ca-timeline" class="mw-list-item vector-tab-noicon {% if wiki_tabs.timeline.is_active %}selected is-active{% endif %}">
                  <a href="{{ wiki_tabs.timeline.url }}" class="{% if wiki_tabs.timeline.is_active %}is-active{% endif %}">
                    <span>{{ 'Timeline'|t }}</span>
                  </a>
                </li>
                <li id="ca-edit" class="mw-list-item vector-tab-noicon {% if wiki_tabs.edit.is_active %}selected is-active{% endif %}">
                  <a href="{{ wiki_tabs.edit.url }}" title="{{ 'Edit this page'|t }}" class="{% if wiki_tabs.edit.is_active %}is-active{% endif %}">
                    <span>{{ 'Edit'|t }}</span>
                  </a>
                </li>
                <li id="ca-history" class="mw-list-item vector-tab-noicon {% if wiki_tabs.history.is_active %}selected is-active{% endif %}">
                  <a href="{{ wiki_tabs.history.url }}" title="{{ 'Past revisions of this page'|t }}" class="{% if wiki_tabs.history.is_active %}is-active{% endif %}">
                    <span>{{ 'History'|t }}</span>
                  </a>
                </li>
                {% if wiki_extra_tabs is not empty %}
                  <li class="vector-menu-dropdown mw-list-item">
                    <details class="vector-tools-dropdown">
                      <summary class="vector-tools-summary"><span>{{ 'More'|t }} ▾</span></summary>
                      <ul class="vector-tools-menu">
                        {% for extra in wiki_extra_tabs %}
                          <li class="{% if extra.is_active %}is-active{% endif %}">
                            <a href="{{ extra.url }}" class="{% if extra.is_active %}is-active{% endif %}">
                              <span>{{ extra.title }}</span>
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </details>
                  </li>
                {% endif %}
              </ul>
            </div>
          </div>
        </nav>
      </div>
    </div>
  </div>
{% elseif primary %}
  <div class="local-tasks-container">
    <details class="local-tasks-collapsible" {% if tasks_open %}open{% endif %}>
      <summary class="local-tasks-summary" title="{{ 'Toggle page management options'|t }}">
        <span class="local-tasks-summary-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </span>
        <span class="local-tasks-summary-text">
          <span class="local-tasks-label">{{ 'Page actions'|t }}</span>
          {% if active_tab_title %}
            <span class="local-tasks-active-badge">{{ active_tab_title }}</span>
          {% endif %}
        </span>
        <span class="local-tasks-chevron" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="local-tasks-drawer">
        <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
        <ul class="tabs tabs--primary">
          {{ primary }}
        </ul>
      </div>
    </details>
  </div>
{% endif %}
{% if secondary %}
  <div class="local-tasks-secondary-container">
    <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
    <ul class="tabs tabs--secondary">
      {{ secondary }}
    </ul>
  </div>
{% endif %}
