{#
/**
 * @file
 * Display a node in minicard view mode using Single Directory Component.
 */
#}
<div{{ attributes }}>
  {% embed 'kaliyattam_subtheme:card' with {
    title: label,
    url: url,
    variant: 'minicard',
  } %}
    {% block image %}
      {{ content.field_featured_image }}
    {% endblock %}
  {% endembed %}
</div>
