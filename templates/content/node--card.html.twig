{#
/**
 * @file
 * Timeline Card template for Kaliyattam feeds.
 *
 * Implements social-style card layout:
 * - Avatar, author, relative time, bundle badge
 * - Pinned badge for sticky items
 * - Content body / text excerpt
 * - Responsive media grid (1-4 images)
 * - Click-to-play video embed (zero iframe until clicked)
 * - Related chips (Theyyam, Place, Event date)
 * - Action bar: Like, Comments
 */
#}
{%
  set classes = [
    'timeline-card',
    'timeline-card--' ~ node.bundle|clean_class,
    node.isSticky() ? 'timeline-card--sticky' : '',
    view_mode ? 'timeline-card--' ~ view_mode|clean_class : '',
  ]
%}

{% set author = node.getOwner() %}
{% set author_name = author.getDisplayName()|default('Kaliyattam Artist') %}
{% set author_initial = author_name|slice(0, 1)|upper %}
{% set bundle_labels = {
  'theyyam': 'Theyyam'|t,
  'location': 'Temple / Place'|t,
  'event': 'Event'|t,
  'post': 'Post'|t
} %}
{% set bundle_icons = {
  'theyyam': '🎭',
  'location': '🛕',
  'event': '📅',
  'post': '💬'
} %}
{% set post_category_name = (node.bundle() == 'post' and node.field_post_category is not empty and node.field_post_category.entity) ? node.field_post_category.entity.label() : '' %}
{% set is_wiki = node.bundle() in ['theyyam', 'location'] %}
{% set is_updates = is_updates_page or (view.storage.id is defined and view.storage.id == 'updates') or (view.id is defined and view.id == 'updates') %}
{% set card_url = url ?: path('entity.node.canonical', {'node': node.id()}) %}

<article{{ attributes.addClass(classes) }} data-node-id="{{ node.id() }}" data-bundle="{{ node.bundle() }}">
  {# Card Header: Author / Wiki Meta, and Badges #}
  <header class="timeline-card-header{{ is_wiki ? ' timeline-card-header--wiki' : '' }}">
    {% if is_wiki %}
      <div class="timeline-card-wiki-group w-100">
        <div class="timeline-card-wiki-title-row d-flex align-items-start justify-content-between gap-2 mb-1">
          <h3 class="timeline-card-title m-0">
            <a href="{{ card_url }}">{{ label }}</a>
          </h3>
          <span class="timeline-badge timeline-badge--{{ node.bundle() }} flex-shrink-0">
            <span class="badge-icon" aria-hidden="true">{{ bundle_icons[node.bundle()]|default('📜') }}</span>
            <span class="badge-text">{{ bundle_labels[node.bundle()]|default(node.bundle()) }}</span>
          </span>
        </div>
        <div class="timeline-card-time-line">
          <a href="{{ card_url }}" class="timeline-card-time-link" rel="bookmark" title="{{ 'View details'|t }}">
            <i class="bi bi-clock-history me-1" aria-hidden="true"></i>
            <span>{{ 'Last updated on:'|t }}</span>&nbsp;
            <time datetime="{{ node.getChangedTime()|date('c') }}" class="timeline-card-time">
              {{ node.getChangedTime()|format_date('medium') }}
            </time>
          </a>
        </div>
      </div>
    {% elseif node.bundle() == 'event' and is_updates %}
      <div class="timeline-card-event-header w-100">
        <div class="timeline-card-event-title-row d-flex align-items-start justify-content-between gap-2 mb-1">
          <h3 class="timeline-card-title m-0">
            <a href="{{ card_url }}">{{ label }}</a>
          </h3>
          <span class="timeline-badge timeline-badge--event flex-shrink-0">
            <span class="badge-icon" aria-hidden="true">{{ bundle_icons['event']|default('📅') }}</span>
            <span class="badge-text">{{ bundle_labels['event']|default('Event'|t) }}</span>
          </span>
        </div>
        <div class="timeline-card-subtle-author">
          <span class="subtle-author-text">
            {{ 'Posted by'|t }} <a href="/user/{{ author.id() }}/timeline?page=1" class="subtle-author-link">{{ author_name }}</a>
          </span>
          <span class="subtle-author-sep" aria-hidden="true">•</span>
          <time datetime="{{ node.getCreatedTime()|date('c') }}" class="subtle-author-time">
            {{ node.getCreatedTime()|format_date('medium') }}
          </time>
        </div>
      </div>
    {% else %}
      <div class="timeline-card-author-group">
        <a href="/user/{{ author.id() }}/timeline?page=1" class="timeline-card-avatar" aria-hidden="true" tabindex="-1">
          <span class="avatar-initial">{{ author_initial }}</span>
        </a>
        <div class="timeline-card-meta">
          <div class="timeline-card-author-line">
            <a href="/user/{{ author.id() }}/timeline?page=1" class="timeline-card-author-name">{{ author_name }}</a>
            <span class="timeline-badge timeline-badge--{{ node.bundle() }}">
              <span class="badge-icon" aria-hidden="true">{{ bundle_icons[node.bundle()]|default('📜') }}</span>
              <span class="badge-text">{{ post_category_name ?: (bundle_labels[node.bundle()]|default(node.bundle())) }}</span>
            </span>
          </div>
          <div class="timeline-card-time-line">
            <a href="{{ card_url }}" class="timeline-card-time-link" rel="bookmark" title="{{ node.bundle() == 'post' ? 'View full post'|t : 'View details'|t }}">
              <time datetime="{{ node.getCreatedTime()|date('c') }}" class="timeline-card-time">
                {{ node.getCreatedTime()|format_date('medium') }}
              </time>
            </a>
            {% if node.bundle() == 'post' and node.field_visibility.value %}
              <span class="timeline-visibility-pill timeline-visibility--{{ node.field_visibility.value }}">
                {% if node.field_visibility.value == 'public' %}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1a7 7 0 0 0 0 14A7 7 0 0 0 8 1zm0 2.5a4.5 4.5 0 0 1 4.5 4.5c0 1.2-.5 2.3-1.3 3.1-.3-.6-.8-1.1-1.5-1.4a2 2 0 0 0-.7-.2V9a1 1 0 0 0-1-1H7V7a1 1 0 0 0-1-1h-.5a1 1 0 0 0-1 1v.5H4a4.5 4.5 0 0 1 4-4z"/></svg>
                  {{ 'Public'|t }}
                {% elseif node.field_visibility.value == 'authenticated' %}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.25c-.2-.4-1.2-1.75-5-1.75-3.8 0-4.8 1.35-5 1.75h10z"/></svg>
                  {{ 'Members'|t }}
                {% else %}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a3 3 0 0 0-3 3v2H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-1V4a3 3 0 0 0-3-3zm1 5H7V4a1 1 0 1 1 2 0v2z"/></svg>
                  {{ 'Private'|t }}
                {% endif %}
              </span>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}

    {# Pinned Indicator #}
    {% if is_pinned or node.isSticky() %}
      <div class="timeline-pinned-indicator" title="{{ 'Pinned to top of feed'|t }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/></svg>
        <span>{{ 'Pinned'|t }}</span>
      </div>
    {% endif %}
  </header>

  {# Card Main Content #}
  <div class="timeline-card-body">
    {% if label and not is_wiki and node.bundle() != 'post' and not (node.bundle() == 'event' and is_updates) %}
      <h3 class="timeline-card-title">
        <a href="{{ card_url }}">{{ label }}</a>
      </h3>
    {% endif %}

    <div class="timeline-card-text">
      {% if node.hasField('field_content') and not node.field_content.isEmpty() %}
        {{ content.field_content }}
      {% elseif node.hasField('body') and not node.body.isEmpty() %}
        {{ content.body }}
      {% endif %}
    </div>

    {# Media Grid / Lazy Video Embed #}
    {% if node.hasField('field_media') and not node.field_media.isEmpty() %}
      <div class="timeline-card-media-wrapper">
        <div class="timeline-card-media-grid">
          {{ content.field_media }}
        </div>
      </div>
    {% elseif node.hasField('field_featured_image') and not node.field_featured_image.isEmpty() %}
      <div class="timeline-card-media-wrapper">
        <div class="timeline-card-featured-img">
          {{ content.field_featured_image }}
        </div>
      </div>
    {% endif %}

    {# Related Chips Row #}
    {% set when_rendered = content.field_when|render %}
    {% set theyyam_rendered = content.field_theyyam|render %}
    {% set where_rendered = content.field_where|render %}
    {% set address_rendered = content.field_location_address|render %}
    {% set tags_rendered = content.field_tags|render %}

    {# Google Maps URL for Location cards on /temples #}
    {% set maps_url = '' %}
    {% if node.bundle() == 'location' %}
      {% if node.field_geofield and node.field_geofield.lat and node.field_geofield.lon %}
        {% set maps_url = 'https://www.google.com/maps/search/?api=1&query=' ~ node.field_geofield.lat|trim ~ ',' ~ node.field_geofield.lon|trim %}
      {% elseif has_address %}
        {% set addr_query = [node.label(), node.field_location_address.address_line1, node.field_location_address.locality, node.field_location_address.postal_code]|filter(v => v is not empty)|join(', ') %}
        {% set maps_url = 'https://www.google.com/maps/search/?api=1&query=' ~ addr_query|url_encode %}
      {% endif %}
    {% endif %}

    {% set has_when = when_rendered|striptags|trim is not empty %}
    {% set has_theyyam = theyyam_rendered|striptags|trim is not empty %}
    {% set has_where = where_rendered|striptags|trim is not empty %}
    {% set has_address = address_rendered|striptags|trim is not empty %}
    {% set has_tags = tags_rendered|striptags|trim is not empty %}
    {% set has_map_link = (node.bundle() == 'location' and maps_url is not empty) %}

    {% if has_when or has_theyyam or has_where or has_address or has_tags or has_map_link %}
      <div class="timeline-card-chips">
        {% if has_when %}
          <span class="timeline-chip timeline-chip--date" title="{{ 'Event Time'|t }}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {{ when_rendered|raw }}
          </span>
        {% endif %}

        {% if has_theyyam and node.bundle != 'location' %}
          <div class="timeline-chip timeline-chip--theyyam" title="{{ 'Related Theyyam'|t }}">
            <span class="chip-label" aria-hidden="true">🎭</span>
            {{ theyyam_rendered|raw }}
          </div>
        {% endif %}

        {% if has_where %}
          <div class="timeline-chip timeline-chip--place" title="{{ 'Performance Place'|t }}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {{ where_rendered|raw }}
          </div>
        {% endif %}

        {% if has_map_link %}
          <div class="timeline-chip timeline-chip--address timeline-chip--map-link" title="{{ 'View on Google Maps'|t }}">
            <a href="{{ maps_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'View @title on Google Maps'|t({'@title': node.label()}) }}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </a>
          </div>
        {% elseif has_address %}
          <div class="timeline-chip timeline-chip--address" title="{{ 'Location Address'|t }}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            {{ address_rendered|raw }}
          </div>
        {% endif %}

        {% if has_tags %}
          <div class="timeline-chip timeline-chip--tags" title="{{ 'Tags'|t }}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            {{ tags_rendered|raw }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {# Card Action Bar #}
  {% set like_action = flag_like_node is not empty ? flag_like_node : content.flag_like_node %}

  <footer class="timeline-card-actions">
    {% if like_action is not empty %}
      <div class="timeline-action-item action-like">
        {{ like_action }}
      </div>
    {% endif %}

    {# Comments Count / Link #}
    <div class="timeline-action-item action-comments">
      <a href="{{ url }}#comments" class="timeline-action-link comments-action-link" title="{{ 'Join the discussion'|t }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span class="action-label">{{ 'Comments'|t }}</span>
        {% if node.field_comments_without_title.comment_count is defined %}
          <span class="action-count">{{ node.field_comments_without_title.comment_count }}</span>
        {% elseif node.field_comments.comment_count is defined %}
          <span class="action-count">{{ node.field_comments.comment_count }}</span>
        {% endif %}
      </a>
    </div>

    {# More / Read More Action #}
    {% if url %}
      <div class="timeline-action-item action-more">
        <a href="{{ url }}" class="timeline-action-link more-action-link" title="{{ 'View details for'|t }} {{ label }}">
          <span class="action-label">{{ 'More'|t }}</span>
          <span class="action-icon" aria-hidden="true">&raquo;</span>
        </a>
      </div>
    {% endif %}
  </footer>
</article>
