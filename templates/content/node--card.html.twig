{#
/**
 * @file
 * Display a node in card view mode using Single Directory Component.
 */
#}
<div{{ attributes }}>
  {% embed 'kaliyattam_subtheme:card' with {
    title: label,
    url: url,
    date: content.field_event_date is not empty ? content.field_event_date : null,
    variant: 'default',
  } %}
    {% block image %}
      {{ content.field_featured_image }}
    {% endblock %}
    {% block favorite %}
      {{ content.flag_bookmark }}
    {% endblock %}
    {% block content %}
      {{ content|without('field_featured_image', 'field_event_date', 'field_event_location', 'url', 'flag_bookmark') }}
    {% endblock %}
    {% block footer %}
      {% if url %}
        <div class="card-footer-action">
          <a href="{{ url }}" class="card-action-btn" title="{{ 'View details for'|t }} {{ label }}">
            <span>{{ 'More'|t }} &raquo;</span>
          </a>
        </div>
      {% endif %}
    {% endblock %}
  {% endembed %}
</div>
