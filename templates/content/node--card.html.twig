{#
/**
 * @file
 * Display a node in card view mode using Single Directory Component.
 */
#}
<div{{ attributes }}>
  {% embed 'kaliyattam_subtheme:card' with {
    title: label,
    url: url,
    date: content.field_event_date is not empty ? content.field_event_date : null,
    variant: 'default',
  } %}
    {% block image %}
      {{ content.field_featured_image }}
    {% endblock %}
    {% block content %}
      {{ content|without('field_featured_image', 'field_event_date', 'field_event_location', 'url') }}
    {% endblock %}
    {% block footer %}
      {% if url %}
        <div class="card-footer-action">
          <a href="{{ url }}" class="card-action-btn">
            <span>{% if node.bundle == 'location' %}{{ 'Explore Temple'|t }}{% elseif node.bundle == 'theyyam' %}{{ 'Explore Theyyam'|t }}{% elseif node.bundle == 'event' %}{{ 'View Event'|t }}{% else %}{{ 'View Details'|t }}{% endif %}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/></svg>
          </a>
        </div>
      {% endif %}
    {% endblock %}
  {% endembed %}
</div>
