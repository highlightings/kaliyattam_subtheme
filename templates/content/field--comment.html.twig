{#
/**
 * @file
 * Premium themed template for comment field display in Kaliyattam subtheme.
 */
#}
<div{{ attributes.addClass('comments-container') }}>
  {% if comments %}
    <div class="comments-list">
      {{ comments }}
    </div>
  {% else %}
    <div class="no-comments-msg">
      <i class="bi bi-chat-left-dots me-2" aria-hidden="true"></i>
      <span>{{ 'No comments yet. Be the first to join the conversation!'|t }}</span>
    </div>
  {% endif %}

  {% if comment_form %}
    <div class="comment-form-wrapper mt-4 pt-3 border-top" id="comment-form-wrapper">
      <h4 class="comment-form-heading mb-3">
        <i class="bi bi-pencil-square me-2" aria-hidden="true"></i>{{ 'Leave a Comment'|t }}
      </h4>
      {{ comment_form }}
    </div>
  {% elseif not logged_in %}
    <div class="comment-anon-prompt mt-4 p-3 bg-light rounded text-center border">
      <p class="mb-2 text-muted">{{ 'Sign in to share your thoughts and join the discussion.'|t }}</p>
      <a href="{{ path('user.login', {}, {'query': {'destination': current_path|default('')}}) }}" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>{{ 'Log in to Comment'|t }}
      </a>
    </div>
  {% endif %}
</div>
