{#
/**
 * @file
 * Theme override to display a Location node in full view mode.
 */
#}
<article{{ attributes.addClass('node', 'node--type-location', 'node--view-mode-full') }}>
  <div class="container">
    {{ title_prefix }}
    {% if not page %}
      <h1{{ title_attributes.addClass('node-title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h1>
    {% endif %}
    {{ title_suffix }}

    <div{{ content_attributes.addClass('node__content') }}>
      {% if content.field_featured_image is not empty %}
        <div class="theyyam-cover-image">
          {{ content.field_featured_image }}
        </div>
      {% endif %}

      {# Location Map & Address info #}
      {% if node.field_geofield is not empty %}
        <div class="location-geo-wrapper mb-4 p-4 shadow-sm rounded bg-white">
          <div class="location-map">
            {{ content.field_geofield }}
          </div>
          {% if node.field_location_address is not empty %}
            <div class="location-address mt-3">
              <i class="icon icon-location bi-geo-alt me-1" aria-hidden="true"></i>
              <span>{{ content.field_location_address |render|trim|replace({'<br>': ' - '})|striptags|raw }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {# Media Carousel SDC #}
      {% if node.field_media is not empty %}
        {% embed 'kaliyattam_subtheme:media-carousel' with { id: 'location-carousel-' ~ node.id } %}
          {% block slides %}
            {% for media_item in node.field_media %}
              {% if media_item.entity %}
                {% set media_bundle = media_item.entity.bundle %}
                {% if media_bundle == 'image' %}
                  {% set img_uri = media_item.entity.field_media_image.entity.fileuri ?: media_item.entity.thumbnail.entity.fileuri %}
                  {% set img_alt = media_item.entity.field_media_image.alt|default(media_item.entity.label) %}
                  {% if img_uri is not empty %}
                    <div class="carousel-slide carousel-slide--image">
                      <img src="{{ img_uri | image_style('3_2_300x200_focal_point_webp') }}" alt="{{ img_alt }}" loading="lazy">
                    </div>
                  {% endif %}
                {% elseif media_bundle == 'remote_video' %}
                  <div class="carousel-slide carousel-slide--video">
                    {{ drupal_entity('media', media_item.target_id, 'default') }}
                  </div>
                {% else %}
                  <div class="carousel-slide">
                    {{ drupal_entity('media', media_item.target_id) }}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endblock %}
        {% endembed %}
      {% endif %}

      {# Render related Theyyam cards in responsive grid #}
      {% if node.field_theyyam is not empty %}
        <div class="theyyam-related mt-5 mb-5">
          <h2 class="mb-4">{{ 'Theyyam at this location'|trans }}</h2>
          <div class="grid-cards">
            {% for theyyam_item in node.field_theyyam %}
              <div class="theyyam-related-item">
                {{ drupal_entity('node', theyyam_item.target_id, 'card') }}
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {# Render remaining content fields #}
      <div class="node-main-fields">
        {{ content|without('field_media', 'field_theyyam', 'field_comments', 'field_featured_image', 'field_location_address', 'field_geofield') }}
      </div>

      {% if content.field_comments is not empty %}
        <div class="node-comments-section mt-5">
          {{ content.field_comments }}
        </div>
      {% endif %}
    </div>
  </div>
</article>
