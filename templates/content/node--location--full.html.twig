{#
/**
 * @file
 * Theme override to display a node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - node.getCreatedTime() will return the node creation timestamp.
 *   - node.hasField('field_media') returns TRUE if the node has this field.
 *   - node.isPromoted() returns TRUE if the node is promoted.
 *   - node.bundle() returns the machine name of the content type.
 * - label: The title of the node.
 * - content: All node items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the node.
 * - title_attributes: Same as attributes, except for the node title.
 * - content_attributes: Same as attributes, except for the main content area.
 * - author_picture: The author picture rendered good old fashioned way.
 * - author_name: The name of the author.
 * - date: Formatted creation date.
 * - is_front: TRUE if the current page is the front page.
 * - logged_in: TRUE if the user is registered and signed in.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - collapsed: TRUE if the node is collapsed.
 * - More variables may be available through preprocess functions.
 *
 * @see template_preprocess_node()
 */
#}
<article{{ attributes }}>
  <div class="container">
    {{ title_prefix }}
    {% if not page %}
      <h2{{ title_attributes }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}

    <div{{ content_attributes.addClass('node__content') }}>
      {% if content.field_featured_image is not empty %}
        <div class="row">
          <div class="col-12">     
            <div class="theyyam-cover-image rounded-top" >
            {{ content.field_featured_image }}
            </div>
          </div>
        </div>
      {% endif %}
      {% if node.field_geofield is not empty %}
        {% if node.field_location_address is not empty %}
          <div class="row shadow">
              <div class="col-12">
                  <p >{{ content.field_geofield }}</p>
              </div>
              <div class="col-12">
                  <p >{{ content.field_location_address |render|trim|replace({'<br>': ' - '})|striptags|raw  }}</p>
              </div>
          </div> 
        {% else %}
          <div class="row shadow">
              <div class="col-12">
                  <p >{{ content.field_geofield }}</p>
              </div>
          </div>
        {% endif %}
      {% endif %}

      {# Bootstrap 5.3 Carousel for Media #}
      {% if node.field_media is not empty %}
        <div class="row  bg-secondary" data-bs-theme="light">
          <div class="col-12">
            <div id="carousel-{{ node.id }}" class="carousel slide mb-4" data-bs-ride="carousel">
              <div class="carousel-indicators" >
                {% for key, media_item in node.field_media %}
                  <button type="button" data-bs-target="#carousel-{{ node.id }}" data-bs-slide-to="{{ key }}" class="{{ loop.first ? 'active' : ' ' }}" aria-current="{{ loop.first ? 'true' : 'false' }}" aria-label="Slide {{ loop.index }}"></button>
                {% endfor %}
              </div>
              <div class="carousel-inner" >
                {% for media_item in node.field_media %}
                  <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                    {% set img_uri = media_item.entity.field_media_image.entity.fileuri %}
                    {% set img_alt = media_item.entity.field_media_image.alt %}
                    <div class="col-12 mx-auto col-md-6 justify-content-center">
                      <img class="d-block w-100 mx-auto img-thumbnail" src="{{ img_uri | image_style('3_2_300x200_focal_point_webp') }}" alt="{{ img_alt }}">
                    </div>
                  </div>
                {% endfor %}
              </div>
              <button class="carousel-control-prev" type="button" data-bs-target="#carousel-{{ node.id }}" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carousel-{{ node.id }}" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </div>
          </div>
        </div>
      {% endif %}

      {# Render the Theyyam teaser using Bootstrap Cards in a grid #}
      {% if node.field_theyyam is not empty %}
        <div class="theyyam-related mt-5">
          <h3 class="mb-3">{{ 'Theyyam at this location'|trans }}</h3>
          <div class="row">
            {% for theyyam_item in node.field_theyyam %}
              <div class="col-md-6 col-lg-4 mb-4">
                {# drupal_entity renders the node in 'teaser' view mode, which can be styled as a card #}
                {{ drupal_entity('node', theyyam_item.target_id, 'card') }}
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
      
      {# Render all other content fields except the ones we've handled #}
      <div class="row">
        <div class="col-12">     
          {{ content|without('field_media', 'field_theyyam', 'field_comments','field_featured_image', 'field_location_address', 'field_geofield') }}
        </div>
      </div>
      <div class="row">
        <div class="col-12">
          {{ content.field_comments }}
        </div>
      </div>
    </div>

  </div>
</article>
