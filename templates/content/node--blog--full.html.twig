{#
/**
 * @file
 * Theme implementation to display a Blog/Article node in full view mode.
 */
#}
<article{{ attributes.addClass('node', 'node--type-article', 'node--view-mode-full') }}>
  <div class="container">
    {{ title_prefix }}
    <header class="article-header mb-4">
      <h1{{ title_attributes.addClass('article-title') }}>
        {{ label }}
      </h1>
      {% if display_submitted %}
        <div class="node__meta">
          {{ author_picture }}
          <span{{ author_attributes }}>
            {{ 'By'|t }} {{ author_name }} — {{ date }}
          </span>
          {{ metadata }}
        </div>
      {% endif %}
    </header>
    {{ title_suffix }}

    <div{{ content_attributes.addClass('node__content') }}>
      {% if content.field_featured_image is not empty %}
        <div class="theyyam-cover-image mb-4">
          {{ content.field_featured_image }}
        </div>
      {% endif %}

      <div class="article-body">
        {{ content|without('field_featured_image', 'field_media', 'field_comments') }}
      </div>

      {% if node.field_media is not empty %}
        <div class="article-media-gallery mt-5 mb-5">
          <h2 class="mb-3">{{ 'Gallery'|t }}</h2>
          {% embed 'kaliyattam_subtheme:media-carousel' with { id: 'article-carousel-' ~ node.id } %}
            {% block slides %}
              {% for media_item in node.field_media %}
                {% if media_item.entity and media_item.entity.access('view') %}
                  <div class="carousel-slide carousel-slide--{{ media_item.entity.bundle }}">
                    {{ drupal_entity('media', media_item.target_id) }}
                  </div>
                {% endif %}
              {% endfor %}
            {% endblock %}
          {% endembed %}
        </div>
      {% endif %}

      {% if content.field_comments is not empty %}
        <div class="node-comments-section mt-5">
          {{ content.field_comments }}
        </div>
      {% endif %}
    </div>
  </div>
</article>
