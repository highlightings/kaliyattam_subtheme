{#
/**
 * @file
 * Theme implementation to display an Event node in full view mode.
 */
#}
<article{{ attributes.addClass('node', 'node--type-event', 'node--view-mode-full', 'event-detail') }}>
  <div class="container">
    <div class="event-detail-card shadow-md rounded bg-white overflow-hidden">
      <div class="row g-0">
        {% if content.field_featured_image is not empty %}
          <div class="col-12 col-md-6 event-image-col">
            <div class="event-image-container">
              {{ content.field_featured_image }}
            </div>
          </div>
        {% endif %}

        <div class="col-12 {{ content.field_featured_image is not empty ? 'col-md-6' : '' }}">
          <div class="p-4 p-md-5">
            {{ title_prefix }}
            <h1{{ title_attributes.addClass('event-title', 'mb-3') }}>
              {{ label }}
            </h1>
            {{ title_suffix }}

            {# Author & Date Metadata Bar with Icons #}
            <div class="node-meta-bar mb-3">
              <div class="node-author-group">
                <a href="{{ author_url }}" class="node-author-avatar" aria-hidden="true" tabindex="-1">
                  <span class="avatar-initial">{{ author_initial }}</span>
                </a>
                <div class="node-meta-info">
                  <div class="node-meta-author">
                    <a href="{{ author_url }}" class="node-author-link">
                      <i class="icon icon-user bi-person me-1" aria-hidden="true"></i>
                      <span>{{ author_name }}</span>
                    </a>
                    {% if flag_follow_user is not empty %}
                      <span class="node-follow-wrapper ms-2">
                        {{ flag_follow_user }}
                      </span>
                    {% endif %}
                  </div>
                  <div class="node-meta-date">
                    <time datetime="{{ node.getCreatedTime()|date('c') }}">
                      <i class="icon icon-calendar bi-calendar-event me-1" aria-hidden="true"></i>
                      <span>{{ node.getCreatedTime()|format_date('medium') }}</span>
                    </time>
                  </div>
                </div>
              </div>
            </div>

            {# Event Schedule & Location #}
            {% if content.field_when is not empty %}
              <div class="event-date mb-3 text-primary fw-semibold">
                <i class="icon icon-calendar bi-calendar-event me-1" aria-hidden="true"></i>
                {{ content.field_when }}
              </div>
            {% elseif content.field_event_date is not empty %}
              <div class="event-date mb-3 text-primary fw-semibold">
                <i class="icon icon-calendar bi-calendar-event me-1" aria-hidden="true"></i>
                {{ content.field_event_date }}
              </div>
            {% endif %}

            {% if content.field_where is not empty %}
              <div class="event-location mb-3 text-muted">
                <i class="icon icon-location bi-geo-alt me-1" aria-hidden="true"></i>
                {{ content.field_where }}
              </div>
            {% elseif content.field_event_location is not empty %}
              <div class="event-location mb-3 text-muted">
                <i class="icon icon-location bi-geo-alt me-1" aria-hidden="true"></i>
                {{ content.field_event_location }}
              </div>
            {% endif %}

            {# Event Month Mini Calendar #}
            {% if event_calendar is not empty %}
              <div class="event-mini-calendar-widget my-3" data-event-year="{{ event_calendar.year }}" data-event-month="{{ event_calendar.month }}">
                <div class="event-calendar-card">
                  <div class="event-calendar-header">
                    <div class="event-calendar-title-group">
                      <i class="icon icon-calendar bi-calendar3 event-calendar-icon" aria-hidden="true"></i>
                      <a href="{{ event_calendar.month_url }}" class="event-calendar-title" title="{{ 'View all events in ' ~ event_calendar.month_year_label }}">
                        {{ event_calendar.month_year_label }}
                      </a>
                    </div>
                    <a href="{{ event_calendar.year_url }}" class="event-calendar-year-badge" title="{{ 'View all ' ~ event_calendar.year ~ ' events' }}">
                      {{ event_calendar.year }}
                    </a>
                  </div>
                  <div class="event-calendar-grid">
                    <div class="event-calendar-weekdays" role="row">
                      {% for wd in event_calendar.weekdays %}
                        <span class="event-calendar-weekday" role="columnheader">{{ wd }}</span>
                      {% endfor %}
                    </div>
                    <div class="event-calendar-days" role="grid">
                      {% if event_calendar.leading_empty > 0 %}
                        {% for i in 1..event_calendar.leading_empty %}
                          <span class="event-calendar-day event-calendar-day--empty" aria-hidden="true"></span>
                        {% endfor %}
                      {% endif %}
                      {% for d in event_calendar.days %}
                        {% if d.is_event %}
                          <a href="{{ d.url }}" class="event-calendar-day event-calendar-day--active" title="{{ 'Event Date: ' ~ d.label }}" aria-label="{{ d.label }}" aria-current="date">
                            <span class="event-calendar-day-number">{{ d.day }}</span>
                            <span class="event-calendar-day-indicator" aria-hidden="true"></span>
                          </a>
                        {% else %}
                          <span class="event-calendar-day event-calendar-day--normal">
                            <span class="event-calendar-day-number">{{ d.day }}</span>
                          </span>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                  <div class="event-calendar-footer">
                    <a href="{{ event_calendar.month_url }}" class="event-calendar-footer-link">
                      <span>{{ 'All @month Events'|t({'@month': event_calendar.month_name}) }}</span>
                      <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                    </a>
                  </div>
                </div>
              </div>
            {% endif %}

            <div class="event-body mt-3">
              {{ content|without('field_featured_image', 'field_media', 'field_when', 'field_where', 'field_event_date', 'field_event_location', 'field_comments', 'flag_favorite_node', 'flag_bookmark', 'flag_like_node', 'flag_sticky_timeline', 'flag_sticky_user_timeline', 'flag_subscribe_node', 'links', 'uid', 'created', 'title') }}
            </div>

            {# Flag Action Links #}
            {% if content.links is not empty %}
              <div class="node-flag-actions mt-4 mb-2">
                {{ content.links }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {% if node.field_media is not empty %}
      <div class="event-media-section mt-5">
        <h2 class="mb-4">{{ 'Event Gallery'|trans }}</h2>
        {% embed 'kaliyattam_subtheme:media-carousel' with { id: 'event-carousel-' ~ node.id } %}
          {% block slides %}
            {% for media_item in node.field_media %}
              {% if media_item.entity %}
                {% set media_bundle = media_item.entity.bundle %}
                {% if media_bundle == 'image' %}
                  {% set img_uri = media_item.entity.field_media_image.entity.fileuri ?: media_item.entity.thumbnail.entity.fileuri %}
                  {% set img_alt = media_item.entity.field_media_image.alt|default(media_item.entity.label) %}
                  {% if img_uri is not empty %}
                    <div class="carousel-slide carousel-slide--image">
                      <img src="{{ img_uri | image_style('3_2_300x200_focal_point_webp') }}" alt="{{ img_alt }}" loading="lazy">
                    </div>
                  {% endif %}
                {% elseif media_bundle == 'remote_video' %}
                  <div class="carousel-slide carousel-slide--video">
                    {{ drupal_entity('media', media_item.target_id, 'default') }}
                  </div>
                {% else %}
                  <div class="carousel-slide">
                    {{ drupal_entity('media', media_item.target_id) }}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endblock %}
        {% endembed %}
      </div>
    {% endif %}

    {% if content.field_comments is not empty %}
      <div class="node-comments-section mt-5">
        {{ content.field_comments }}
      </div>
    {% endif %}
  </div>
</article>
