{#
/**
 * @file
 * Timeline Compact template for Kaliyattam feeds and sidebar blocks.
 */
#}
{%
  set classes = [
    'timeline-compact-item',
    'timeline-compact-item--' ~ node.bundle|clean_class,
  ]
%}
{% set author = node.getOwner() %}
{% set bundle_icons = {
  'theyyam': '🎭',
  'location': '🛕',
  'event': '📅',
  'post': '💬'
} %}

<div{{ attributes.addClass(classes) }}>
  <span class="compact-icon" aria-hidden="true">{{ bundle_icons[node.bundle()]|default('📜') }}</span>
  <div class="compact-content">
    {% if node.bundle() == 'post' %}
      <a href="{{ url }}" class="compact-title">{{ content.field_content|render|striptags|default(content.body|render|striptags)|trim|slice(0, 50) ~ '...' }}</a>
    {% else %}
      <a href="{{ url }}" class="compact-title">{{ label }}</a>
    {% endif %}
    {% if content.field_when is not empty %}
      <div class="compact-meta">{{ content.field_when }}</div>
    {% elseif content.field_theyyam is not empty %}
      <div class="compact-meta">{{ content.field_theyyam }}</div>
    {% endif %}
  </div>
  {% set like_action = flag_like_node is not empty ? flag_like_node : content.flag_like_node %}
  {% if like_action is not empty %}
    <div class="compact-flag">
      {{ like_action }}
    </div>
  {% endif %}
  <a href="{{ url }}#comments" class="compact-comments" title="{{ 'Comments'|t }}">
    <i class="bi bi-chat-dots" aria-hidden="true"></i>
    <span>{{ node.field_comments_without_title.comment_count|default(node.field_comments.comment_count|default(0)) }}</span>
  </a>
</div>
