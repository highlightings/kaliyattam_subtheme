{#
/**
 * @file
 * Theme implementation to display a node in teaser/grid view mode.
 * This is the generic template used as a fallback for all content types
 * that don't have a specific node--[type]--teaser.html.twig file.
 */
#}

{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-teaser'
] %}



<div class="container">
    <div class="row">
        <div class="col-3">     
            {% if content.field_featured_image is not empty %}
            <a href="{{ url }}" class="text-decoration-none">
                {{ content.field_featured_image.0|merge({ '#attributes': { 'class': ['card-img', 'img-fluid', 'rounded-start'] } }) }}
            </a>
            {% endif %}
        </div> 
        <div class="col-9">
            <div class="row align-items-start"><div class="col">
                <h5 class="content-card-title mb-1">
                    <a href="{{ url }}" class="text-decoration-none text-dark hover-link">{{ label }}</a>
                </h5>
            </div></div>
            <div class="row align-items-center"><div class="col">
                <p >{{ content|without('field_featured_image') }}
            </div></div>
            <div class="row align-items-end">
                <div class="col-10 text-left">
                    <p ><small class="text-muted">{{ node.bundle|capitalize }} By {{ author_name }} &bull; {{ date }}</small></p>
                </div>
                <div class="col-2 text-right">
                    <a href="{{ url }}" class="btn btn-sm btn-link p-0 mt-2">Read More &rarr;</a></p>
                </div>                
            </div>
        </div>
    </div>
</div>
