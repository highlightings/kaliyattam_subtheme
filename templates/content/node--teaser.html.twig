{#
/**
 * @file
 * Display a node in teaser view mode using Single Directory Component.
 */
#}
<div{{ attributes }}>
  {% embed 'kaliyattam_subtheme:card' with {
    title: label,
    url: url,
    variant: 'default',
  } %}
    {% block image %}
      {{ content.field_featured_image }}
    {% endblock %}
    {% block content %}
      {{ content|without('field_featured_image', 'field_location_address', 'field_geofield', 'url') }}
    {% endblock %}
  {% endembed %}
</div>
