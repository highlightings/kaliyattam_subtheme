
<div class="container shadow">
    <div class="row ">
        <div class="col ">
            <h5 class="content-card-title mb-1">
                {{ label }}
            </h5>
        </div>
    </div> 
    <div class="row">
        <div class="col">     
            {% if content.field_featured_image is not empty %}
                <div class="theyyam-cover-image rounded-top" >
                    {{ content.field_featured_image }}
                </div>
            {% endif %}
        </div>
    </div>
    <div class="row ">
        <div class="col-8">
            <p >{{ content|without('field_featured_image') }}   </p>         
        </div>
        <div class="col-4">     
        </div>
    </div>
    <div class="row">
        {% for media in node.field_media  %}
          <div class="col shadow">
            <img src="{{ file_url(media.entity.field_image.entity.uri.value) }}">
          </div>
        {% endfor %}    
    </div>

</div>
