{#
/**
 * @file
 * Theme override to display a Theyyam node in full view mode.
 */
#}
<article{{ attributes.addClass('node', 'node--type-theyyam', 'node--view-mode-full') }}>
  <div class="container">
    {{ title_prefix }}
    {% if not page %}
      <h1{{ title_attributes.addClass('node-title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h1>
    {% endif %}
    {{ title_suffix }}

    {# Node Author & Date Metadata Bar with Icons #}
    <div class="node-meta-bar mb-4">
      <div class="node-author-group">
        <a href="{{ author_url }}" class="node-author-avatar" aria-hidden="true" tabindex="-1">
          <span class="avatar-initial">{{ author_initial }}</span>
        </a>
        <div class="node-meta-info">
          <div class="node-meta-author">
            <a href="{{ author_url }}" class="node-author-link">
              <i class="icon icon-user bi-person me-1" aria-hidden="true"></i>
              <span>{{ author_name }}</span>
            </a>
            {% if flag_follow_user is not empty %}
              <span class="node-follow-wrapper ms-2">
                {{ flag_follow_user }}
              </span>
            {% endif %}
          </div>
          <div class="node-meta-date">
            <time datetime="{{ node.getCreatedTime()|date('c') }}">
              <i class="icon icon-calendar bi-calendar-event me-1" aria-hidden="true"></i>
              <span>{{ node.getCreatedTime()|format_date('medium') }}</span>
            </time>
          </div>
        </div>
      </div>
    </div>

    <div{{ content_attributes.addClass('node__content') }}>
      {% if content.field_featured_image is not empty %}
        <div class="theyyam-cover-image">
          {{ content.field_featured_image }}
        </div>
      {% endif %}

      {# Media Carousel SDC #}
      {% if node.field_media is not empty %}
        {% embed 'kaliyattam_subtheme:media-carousel' with { id: 'theyyam-carousel-' ~ node.id } %}
          {% block slides %}
            {% for media_item in node.field_media %}
              {% if media_item.entity %}
                {% set media_bundle = media_item.entity.bundle %}
                {% if media_bundle == 'image' %}
                  {% set img_uri = media_item.entity.field_media_image.entity.fileuri ?: media_item.entity.thumbnail.entity.fileuri %}
                  {% set img_alt = media_item.entity.field_media_image.alt|default(media_item.entity.label) %}
                  {% if img_uri is not empty %}
                    <div class="carousel-slide carousel-slide--image">
                      <img src="{{ img_uri | image_style('3_2_300x200_focal_point_webp') }}" alt="{{ img_alt }}" loading="lazy">
                    </div>
                  {% endif %}
                {% elseif media_bundle == 'remote_video' %}
                  <div class="carousel-slide carousel-slide--video">
                    {{ drupal_entity('media', media_item.target_id, 'default') }}
                  </div>
                {% else %}
                  <div class="carousel-slide">
                    {{ drupal_entity('media', media_item.target_id) }}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endblock %}
        {% endembed %}
      {% endif %}

      {# Flag Action Links #}
      {% if content.links is not empty %}
        <div class="node-flag-actions mb-4">
          {{ content.links }}
        </div>
      {% endif %}

      {# Main node fields #}
      <div class="node-main-fields">
        {{ content|without('field_media', 'field_comments', 'field_featured_image', 'flag_favorite_node', 'flag_bookmark', 'flag_like_node', 'flag_sticky_timeline', 'flag_sticky_user_timeline', 'flag_subscribe_node', 'links', 'uid', 'created', 'title') }}
      </div>

      {% if content.field_comments is not empty %}
        <div class="node-comments-section mt-5">
          {{ content.field_comments }}
        </div>
      {% endif %}
    </div>
  </div>
</article>
