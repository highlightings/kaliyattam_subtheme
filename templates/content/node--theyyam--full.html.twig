{#
/**
 * @file
 * Theme override to display a Theyyam node in full view mode.
 * Wiki-style collaborative page.
 */
#}
<article{{ attributes.addClass('node', 'node--type-theyyam', 'node--view-mode-full', 'wiki-node-view') }}>
  <div class="container">
    {{ title_prefix }}
    {% if not page %}
      <h1{{ title_attributes.addClass('node-title', 'mb-3') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h1>
    {% endif %}
    {{ title_suffix }}

    <div{{ content_attributes.addClass('node__content') }}>
      {% if content.field_featured_image is not empty %}
        <div class="theyyam-cover-image mb-4">
          {{ content.field_featured_image }}
        </div>
      {% endif %}

      {# Media Carousel SDC #}
      {% if node.field_media is not empty %}
        {% embed 'kaliyattam_subtheme:media-carousel' with { id: 'theyyam-carousel-' ~ node.id } %}
          {% block slides %}
            {% for media_item in node.field_media %}
              {% if media_item.entity %}
                {% set media_bundle = media_item.entity.bundle %}
                {% if media_bundle == 'image' %}
                  {% set img_uri = media_item.entity.field_media_image.entity.fileuri ?: media_item.entity.thumbnail.entity.fileuri %}
                  {% set img_alt = media_item.entity.field_media_image.alt|default(media_item.entity.label) %}
                  {% if img_uri is not empty %}
                    <div class="carousel-slide carousel-slide--image">
                      <img src="{{ img_uri | image_style('3_2_300x200_focal_point_webp') }}" alt="{{ img_alt }}" loading="lazy">
                    </div>
                  {% endif %}
                {% elseif media_bundle == 'remote_video' %}
                  <div class="carousel-slide carousel-slide--video">
                    {{ drupal_entity('media', media_item.target_id, 'default') }}
                  </div>
                {% else %}
                  <div class="carousel-slide">
                    {{ drupal_entity('media', media_item.target_id) }}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endblock %}
        {% endembed %}
      {% endif %}

      {# Flag Action Links #}
      {% if logged_in %}
        {% if content.links is not empty %}
          <div class="node-flag-actions mb-4">
            {{ content.links }}
          </div>
        {% endif %}
      {% else %}
        <div class="node-flag-actions-anon d-flex flex-wrap align-items-center gap-2 mb-4">
          <a href="{{ path('user.login', {}, {'query': {'destination': url}}) }}" class="action-flag action-flag-anon" title="{{ 'Log in to add to favorites'|t }}">
            <i class="bi bi-heart me-1" aria-hidden="true"></i>{{ 'Favorite'|t }}
          </a>
          <a href="{{ path('user.login', {}, {'query': {'destination': url}}) }}" class="action-flag action-flag-anon" title="{{ 'Log in to bookmark'|t }}">
            <i class="bi bi-bookmark me-1" aria-hidden="true"></i>{{ 'Bookmark'|t }}
          </a>
        </div>
      {% endif %}

      {# Main node fields #}
      <div class="node-main-fields">
        {{ content|without('field_media', 'field_comments', 'field_featured_image', 'flag_favorite_node', 'flag_bookmark', 'flag_like_node', 'flag_sticky_timeline', 'flag_sticky_user_timeline', 'flag_subscribe_node', 'links', 'uid', 'created', 'title') }}
      </div>

      {# Collaborative Wiki Community Call to Action #}
      <div class="wiki-community-cta card p-4 my-5 border-0 shadow-sm">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="wiki-cta-icon fs-1 text-primary">
              <i class="bi bi-pencil-square" aria-hidden="true"></i>
            </div>
            <div>
              <h4 class="h5 mb-1">{{ 'Help document this Theyyam deity & ritual'|t }}</h4>
              <p class="mb-0 text-muted small">
                {{ 'Kaliyattam is an open cultural archive. If you have authentic thottam songs, origin folklore, or ritual details, authorized contributors are invited to improve this page.'|t }}
              </p>
            </div>
          </div>
          <div class="wiki-cta-actions d-flex align-items-center gap-2">
            <a href="{{ path('entity.node.edit_form', {'node': node.id}) }}" class="btn btn-primary btn-sm px-3">
              <i class="bi bi-pencil me-1" aria-hidden="true"></i>{{ 'Edit this page'|t }}
            </a>
            <a href="{{ path('entity.node.version_history', {'node': node.id}) }}" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-clock-history me-1" aria-hidden="true"></i>{{ 'Edit history'|t }}
            </a>
          </div>
        </div>
      </div>

      {# Wiki Page Metadata Footer (moved from top, no author name, shows last updated) #}
      <footer class="wiki-node-footer pt-3 mt-4 border-top text-muted d-flex flex-wrap justify-content-between align-items-center gap-2 small">
        <div class="wiki-last-updated">
          <i class="bi bi-clock-history me-1" aria-hidden="true"></i>
          <span>{{ 'Last updated on'|t }} {{ last_updated_date|default(node.getChangedTime()|format_date('medium')) }}</span>
        </div>
        <div class="wiki-history-links">
          <a href="{{ path('entity.node.version_history', {'node': node.id}) }}" class="text-decoration-none text-muted">
            <i class="bi bi-journals me-1" aria-hidden="true"></i>{{ 'View versions & revision history'|t }}
          </a>
        </div>
      </footer>

      {% if content.field_comments is not empty %}
        <div class="node-comments-section mt-5">
          {{ content.field_comments }}
        </div>
      {% endif %}
    </div>
  </div>
</article>
