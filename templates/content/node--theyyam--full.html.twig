{#
/**
 * @file
 * Theme override to display a Theyyam node in full view mode.
 * Wiki-style collaborative page.
 */
#}
<article{{ attributes.addClass('node', 'node--type-theyyam', 'node--view-mode-full', 'wiki-node-view') }}>
  <div class="container">
    {{ title_prefix }}
    {% if not page %}
      <h1{{ title_attributes.addClass('node-title', 'mb-3') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h1>
    {% endif %}
    {{ title_suffix }}

    <div{{ content_attributes.addClass('node__content') }}>
      {% if content.field_featured_image is not empty %}
        <div class="theyyam-cover-image mb-4">
          {{ content.field_featured_image }}
        </div>
      {% endif %}

      {# Media Carousel SDC #}
      {% if node.field_media is not empty %}
        {% embed 'kaliyattam_subtheme:media-carousel' with { id: 'theyyam-carousel-' ~ node.id } %}
          {% block slides %}
            {% for media_item in node.field_media %}
              {% if media_item.entity %}
                <div class="carousel-slide carousel-slide--{{ media_item.entity.bundle() }}">
                  {{ drupal_entity('media', media_item.target_id) }}
                </div>
              {% endif %}
            {% endfor %}
          {% endblock %}
        {% endembed %}
      {% endif %}

      {# Main node fields #}
      <div class="node-main-fields">
        {{ content|without('field_media', 'field_comments', 'field_featured_image', 'flag_favorite_node', 'flag_bookmark', 'flag_like_node', 'flag_sticky_timeline', 'flag_sticky_user_timeline', 'flag_subscribe_node', 'links', 'uid', 'created', 'title') }}
      </div>

      {# Node Interaction Bar (Bottom of Content) #}
      <div class="node-interaction-bar post-interaction-bar d-flex flex-wrap align-items-center gap-2 py-3 my-4">
        {% if logged_in %}
          <div class="node-action-flags d-flex flex-wrap align-items-center gap-2">
            {% if flag_favorite_node is not empty %}
              {{ flag_favorite_node }}
            {% endif %}
            {% if flag_like_node is not empty %}
              {{ flag_like_node }}
            {% endif %}
            <button type="button" class="action-flag timeline-action-btn btn-copy-link" data-url="{{ url }}" title="{{ 'Copy link to clipboard'|t }}" aria-label="{{ 'Copy link to this item'|t }}">
              <i class="bi bi-share me-1" aria-hidden="true"></i><span>{{ 'Share'|t }}</span>
            </button>
            <a href="#comments" class="action-flag timeline-action-link comments-scroll-btn" title="{{ 'Jump to comments'|t }}" aria-expanded="false">
              <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><span>{{ 'Comments'|t }}</span>
              {% if comment_count is defined and comment_count > 0 %}
                <span class="action-count ms-1">{{ comment_count }}</span>
              {% endif %}
            </a>
          </div>
        {% else %}
          <div class="post-action-links-anon node-action-flags-anon d-flex flex-wrap align-items-center gap-2">
            <a href="{{ path('user.login', {}, {'query': {'destination': url}}) }}" class="action-flag action-flag-anon" title="{{ 'Log in to add to favorites'|t }}">
              <i class="bi bi-heart me-1" aria-hidden="true"></i><span>{{ 'Favorite'|t }}</span>
            </a>
            <a href="{{ path('user.login', {}, {'query': {'destination': url}}) }}" class="action-flag action-flag-anon" title="{{ 'Log in to like'|t }}">
              <i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i><span>{{ 'Like'|t }}</span>
            </a>
            <a href="{{ path('user.login', {}, {'query': {'destination': url}}) }}" class="action-flag action-flag-anon" title="{{ 'Log in to bookmark'|t }}">
              <i class="bi bi-bookmark me-1" aria-hidden="true"></i><span>{{ 'Bookmark'|t }}</span>
            </a>
            <button type="button" class="action-flag timeline-action-btn btn-copy-link" data-url="{{ url }}" title="{{ 'Copy link to clipboard'|t }}" aria-label="{{ 'Copy link to this item'|t }}">
              <i class="bi bi-share me-1" aria-hidden="true"></i><span>{{ 'Share'|t }}</span>
            </button>
            <a href="#comments" class="action-flag timeline-action-link comments-scroll-btn" title="{{ 'Jump to comments'|t }}" aria-expanded="false">
              <i class="bi bi-chat-dots me-1" aria-hidden="true"></i><span>{{ 'Comments'|t }}</span>
              {% if comment_count is defined and comment_count > 0 %}
                <span class="action-count ms-1">{{ comment_count }}</span>
              {% endif %}
            </a>
          </div>
        {% endif %}
      </div>

      {# Wiki Page Metadata Footer (moved from top, no author name, shows last updated) #}
      <footer class="wiki-node-footer pt-3 mt-4 border-top text-muted d-flex flex-wrap justify-content-between align-items-center gap-2 small">
        <div class="wiki-last-updated">
          <i class="bi bi-clock-history me-1" aria-hidden="true"></i>
          <span>{{ 'Last updated on'|t }} {{ last_updated_date|default(node.getChangedTime()|format_date('medium')) }}</span>
        </div>
        <div class="wiki-history-links">
          <a href="{{ logged_in ? path('entity.node.version_history', {'node': node.id}) : path('user.login', {}, {'query': {'destination': path('entity.node.version_history', {'node': node.id})}}) }}" class="text-decoration-none text-muted">
            <i class="bi bi-journals me-1" aria-hidden="true"></i>{{ 'View versions & revision history'|t }}
          </a>
        </div>
      </footer>

      {% if content.field_comments is not empty %}
        <section id="comments" class="node-comments-section comments-collapsible mt-5 pt-3">
          <h3 class="comments-title mb-3"><i class="bi bi-chat-dots me-2" aria-hidden="true"></i>{{ 'Comments'|t }}</h3>
          {{ content.field_comments }}
        </section>
      {% endif %}
    </div>
  </div>
</article>
