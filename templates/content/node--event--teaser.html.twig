{#
/**
 * @file
 * Theme implementation to display a node (Event content type) in teaser/grid view mode.
 *
 * This template is optimized for use within a Drupal View that uses a Grid,
 * List, or Bootstrap Card layout.
 *
 * Assumed fields:
 * - content.field_event_image (The cover image)
 * - content.field_event_date (The date/time of the event)
 */
#}

{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-teaser',
  'h-100', # Ensures all cards in a row have the same height
  'border-0',
  'shadow-sm',
] %}

<div{{ attributes.addClass(classes) }}>
    <div class="card h-100">
        {# Event Cover Image Link #}
        {% if content.field_event_image is not empty %}
            <a href="{{ url }}" class="text-decoration-none">
                <div class="event-cover-image rounded-top" style="background-image:url('{{ content.field_event_image.0 }}');">
                    {# NOTE: You need to configure the 'Image' field to output the URL only, or rely on a pre-processed image style. #}
                    {# For simplicity, this assumes the image field itself renders an <img>, but it's often better to wrap it in a link. #}
                    {{ content.field_event_image }}
                </div>
            </a>
        {% endif %}

        <div class="card-body p-3">
            {# Event Title Link #}
            <h5 class="content-card-title mb-1">
                <a href="{{ url }}" class="text-decoration-none text-dark hover-link">{{ label }}</a>
            </h5>
            
            {# Event Date #}
            <div class="text-primary small fw-semibold mb-2">
                {% if content.field_event_date is not empty %}
                    <i class="bi bi-calendar-event me-1"></i>
                    {{ content.field_event_date }}
                {% endif %}
            </div>

            {# Event Summary/Body Teaser #}
            {{ content|without('field_event_image', 'field_event_date', 'field_event_location') }}
            
            {# Read More Link (Optional) #}
            <a href="{{ url }}" class="btn btn-sm btn-link p-0 mt-2">View Details &rarr;</a>
        </div>
    </div>
</div>