<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  {% for row in rows %}
    {%
      set row_classes = [
        default_row_class ? 'views-row',
        'col',
      ]
    %}
    <div{{ row.attributes.addClass(row_classes) }}>
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
