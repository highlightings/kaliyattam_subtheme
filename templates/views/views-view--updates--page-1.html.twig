{#
/**
 * @file
 * Theme override for Kaliyattam Updates view (display page_1).
 *
 * Implements a modern community feed layout inspired by released.in/test2:
 * - Clean hero cover with "Welcome to the community" headline and gradient typography
 * - Action buttons ("Explore Timeline" and "Login") with verified valid links
 * - Submenu filter bar with links to site sections
 * - Responsive 3-column community card grid
 * - Author rules:
 *   - Posts: Full author details (avatar, author name, timestamp)
 *   - Events: Subtle author details (inline muted line, no bulky avatar)
 *   - Theyyam & Temples: No author details, only last updated date
 */
#}
{%
  set classes = [
    'view',
    'view-updates',
    'view-id-updates',
    'view-display-id-page_1',
    'updates-community-page',
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

{{ attach_library('kaliyattam_subtheme/updates-community') }}
{{ attach_library('kaliyattam_subtheme/timeline-feeds') }}

<div{{ attributes.addClass(classes) }}>

  {# 1. Community Navigation Submenu Bar (matching released.in/test2 bx-menu-main-bar) #}
  {% set selected_type = view.exposed_raw_input.type|default('') %}
  <nav class="updates-submenu-bar" role="navigation" aria-label="{{ 'Community Sections'|t }}">
    <div class="updates-submenu-container">
      <ul class="updates-submenu-list">
        <li class="updates-submenu-item{{ selected_type is empty ? ' is-active' : '' }}">
          <a href="/updates" class="updates-submenu-link"{% if selected_type is empty %} aria-current="page"{% endif %}>
            <span class="submenu-icon" aria-hidden="true">✨</span>
            <span>{{ 'All'|t }}</span>
          </a>
        </li>
        <li class="updates-submenu-item{{ selected_type == 'post' ? ' is-active' : '' }}">
          <a href="/updates?type=post" class="updates-submenu-link"{% if selected_type == 'post' %} aria-current="page"{% endif %}>
            <span class="submenu-icon" aria-hidden="true">📝</span>
            <span>{{ 'Posts'|t }}</span>
          </a>
        </li>
        <li class="updates-submenu-item{{ selected_type == 'event' ? ' is-active' : '' }}">
          <a href="/updates?type=event" class="updates-submenu-link"{% if selected_type == 'event' %} aria-current="page"{% endif %}>
            <span class="submenu-icon" aria-hidden="true">📅</span>
            <span>{{ 'Events'|t }}</span>
          </a>
        </li>
        <li class="updates-submenu-item{{ selected_type == 'theyyam' ? ' is-active' : '' }}">
          <a href="/updates?type=theyyam" class="updates-submenu-link"{% if selected_type == 'theyyam' %} aria-current="page"{% endif %}>
            <span class="submenu-icon" aria-hidden="true">🎭</span>
            <span>{{ 'Theyyam'|t }}</span>
          </a>
        </li>
        <li class="updates-submenu-item{{ selected_type == 'location' ? ' is-active' : '' }}">
          <a href="/updates?type=location" class="updates-submenu-link"{% if selected_type == 'location' %} aria-current="page"{% endif %}>
            <span class="submenu-icon" aria-hidden="true">🛕</span>
            <span>{{ 'Temples'|t }}</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  {# 3. Main Community Cards Feed #}
  <main class="updates-main-content">
    <div class="updates-feed-wrapper">
      {% if rows %}
        <div class="updates-cards-grid">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="updates-empty-wrapper">
          {{ empty }}
        </div>
      {% endif %}

      {% if pager %}
        <div class="updates-pager-wrapper">
          {{ pager }}
        </div>
      {% endif %}
    </div>
  </main>

</div>
